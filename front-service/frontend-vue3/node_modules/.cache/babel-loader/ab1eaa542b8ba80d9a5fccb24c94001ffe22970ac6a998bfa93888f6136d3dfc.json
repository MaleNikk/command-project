{"ast":null,"code":"import { computed, onMounted, ref } from \"vue\";\nimport { useStore } from \"vuex\";\nimport useTranslations from \"@/composables/useTranslations\";\nimport ProfileInfo from '@/components/Profile/Info';\nimport NewsAdd from \"@/components/News/Add.vue\";\nimport NewsBlock from \"@/components/News/Block.vue\";\nimport Spinner from \"@/components/SpinnerComponents.vue\";\nimport ErrorBlock from \"@/components/ErrorBlock.vue\";\nimport AutoPaginator from \"@/components/AutoPaginator.vue\";\nexport default {\n  name: \"UserProfile\",\n  components: {\n    ProfileInfo,\n    NewsAdd,\n    NewsBlock,\n    Spinner,\n    ErrorBlock,\n    AutoPaginator\n  },\n  setup() {\n    const store = useStore();\n    const {\n      getters,\n      state,\n      dispatch,\n      commit\n    } = store;\n    const activeItem = ref(\"publications\");\n    const {\n      translationsLang\n    } = useTranslations();\n    const getInfo = computed(() => getters[\"profile/info/getInfo\"]);\n    const getWall = computed(() => getters[\"users/info/getWall\"]);\n    const getWallQueuedLength = computed(() => getters[\"users/info/getWallQueuedLength\"]);\n    const getWallPagination = computed(() => getters[\"users/info/getWallPagination\"]);\n    const loading = computed(() => state.global.status.loading);\n    const error = computed(() => state.global.status.error);\n    const errorMessage = computed(() => state.global.status.errorMessage);\n    const filteredWall = computed(() => {\n      const wall = getWall.value;\n      const posted = wall.filter(item => item.type === \"POSTED\");\n      const queued = wall.filter(item => item.type === \"QUEUED\");\n      return {\n        posted,\n        queued\n      };\n    });\n    onMounted(async () => {\n      commit(\"users/info/clearWall\");\n      commit(\"users/info/clearPagination\");\n      if (!getInfo.value) {\n        await dispatch(\"profile/info/apiInfo\");\n      }\n      if (!getWall.value.length) {\n        setMyWall({\n          page: getWallPagination.value.page - 1 || 0\n        });\n      }\n    });\n    const setMyWall = ({\n      page\n    }) => {\n      if (typeof getInfo.value?.id === \"undefined\") return;\n      return dispatch(\"users/info/apiWall\", {\n        accountIds: getInfo.value.id,\n        author: getInfo.value,\n        page\n      });\n    };\n    const isActive = menuItem => {\n      return activeItem.value === menuItem;\n    };\n    const setActive = menuItem => {\n      activeItem.value = menuItem;\n    };\n    return {\n      activeItem,\n      translationsLang,\n      getInfo,\n      getWall,\n      getWallQueuedLength,\n      getWallPagination,\n      loading,\n      error,\n      errorMessage,\n      filteredWall,\n      setMyWall,\n      isActive,\n      setActive\n    };\n  }\n};","map":{"version":3,"names":["computed","onMounted","ref","useStore","useTranslations","ProfileInfo","NewsAdd","NewsBlock","Spinner","ErrorBlock","AutoPaginator","name","components","setup","store","getters","state","dispatch","commit","activeItem","translationsLang","getInfo","getWall","getWallQueuedLength","getWallPagination","loading","global","status","error","errorMessage","filteredWall","wall","value","posted","filter","item","type","queued","length","setMyWall","page","id","accountIds","author","isActive","menuItem","setActive"],"sources":["G:\\develop\\commands_project\\git_hub\\command_project\\frontend-vue3\\src\\pages\\User\\Profile.vue"],"sourcesContent":["<template>\r\n  <div class=\"profile inner-page\" ref=\"page\">\r\n    <div class=\"inner-page__main\">\r\n      <div class=\"profile__info-top\">\r\n        <div class=\"profile__info\">\r\n          <profile-info me=\"me\" online=\"online\" :info=\"getInfo\" />\r\n        </div>\r\n      </div>\r\n\r\n      <div class=\"profile__news\" id=\"mypublications\">\r\n        <div class=\"profile__tabs\">\r\n          <a\r\n            href=\"#\"\r\n            class=\"profile__tab\"\r\n            @click.prevent=\"setActive('publications')\"\r\n            :class=\"{ 'friends__tabs__link active': isActive('publications') }\"\r\n          >\r\n            {{ translationsLang.profileBlockMyPublished }} ({{\r\n              filteredWall.posted.length || 0\r\n            }})\r\n          </a>\r\n\r\n          <a\r\n            href=\"#\"\r\n            class=\"profile__tab\"\r\n            @click.prevent=\"setActive('queuedPublications')\"\r\n            :class=\"{\r\n              'friends__tabs__link active': isActive('queuedPublications'),\r\n            }\"\r\n          >\r\n            {{ translationsLang.profileBlockMyQueued }} ({{\r\n              getWallQueuedLength\r\n            }})\r\n          </a>\r\n        </div>\r\n\r\n        <div class=\"profile__add\">\r\n          <news-add />\r\n        </div>\r\n\r\n        <div class=\"profile__news-list\">\r\n          <error-block v-if=\"!loading && error\" :message=\"errorMessage\" />\r\n\r\n          <div\r\n            class=\"profile__news-list\"\r\n            :class=\"{ active: isActive('publications') }\"\r\n            v-if=\"activeItem === 'publications'\"\r\n          >\r\n            <news-block\r\n              edit=\"edit\"\r\n              deleted=\"deleted\"\r\n              :queued=\"false\"\r\n              v-for=\"news in filteredWall.posted\"\r\n              :key=\"news.id\"\r\n              :info=\"news\"\r\n            />\r\n          </div>\r\n\r\n          <div\r\n            class=\"profile__news-list\"\r\n            :class=\"{ active: isActive('queuedPublications') }\"\r\n            v-if=\"activeItem === 'queuedPublications'\"\r\n          >\r\n            <news-block\r\n              edit=\"edit\"\r\n              deleted=\"deleted\"\r\n              :queued=\"true\"\r\n              v-for=\"news in filteredWall.queued\"\r\n              :key=\"news.id\"\r\n              :info=\"news\"\r\n            />\r\n          </div>\r\n        </div>\r\n\r\n        <div class=\"profile__news-list\">\r\n          <div class=\"spinner-wrapper\" v-if=\"loading\">\r\n            <spinner />\r\n          </div>\r\n\r\n          <auto-paginator\r\n            :page=\"getWallPagination.page\"\r\n            :loading=\"loading\"\r\n            :totalPage=\"getWallPagination.total\"\r\n            :action=\"setMyWall\"\r\n          />\r\n        </div>\r\n      </div>\r\n    </div>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport { computed, onMounted, ref } from \"vue\";\r\nimport { useStore } from \"vuex\";\r\nimport useTranslations from \"@/composables/useTranslations\";\r\nimport ProfileInfo from '@/components/Profile/Info';\r\nimport NewsAdd from \"@/components/News/Add.vue\";\r\nimport NewsBlock from \"@/components/News/Block.vue\";\r\nimport Spinner from \"@/components/SpinnerComponents.vue\";\r\nimport ErrorBlock from \"@/components/ErrorBlock.vue\";\r\nimport AutoPaginator from \"@/components/AutoPaginator.vue\";\r\n\r\nexport default {\r\n  name: \"UserProfile\",\r\n  components: {\r\n    ProfileInfo,\r\n    NewsAdd,\r\n    NewsBlock,\r\n    Spinner,\r\n    ErrorBlock,\r\n    AutoPaginator,\r\n  },\r\n\r\n  setup() {\r\n    const store = useStore();\r\n    const { getters, state, dispatch, commit } = store;\r\n    const activeItem = ref(\"publications\");\r\n    const { translationsLang } = useTranslations();\r\n\r\n    const getInfo = computed(() => getters[\"profile/info/getInfo\"]);\r\n    const getWall = computed(() => getters[\"users/info/getWall\"]);\r\n    const getWallQueuedLength = computed(\r\n      () => getters[\"users/info/getWallQueuedLength\"]\r\n    );\r\n    const getWallPagination = computed(\r\n      () => getters[\"users/info/getWallPagination\"]\r\n    );\r\n    const loading = computed(() => state.global.status.loading);\r\n    const error = computed(() => state.global.status.error);\r\n    const errorMessage = computed(() => state.global.status.errorMessage);\r\n    const filteredWall = computed(() => {\r\n      const wall = getWall.value;\r\n      const posted = wall.filter((item) => item.type === \"POSTED\");\r\n      const queued = wall.filter((item) => item.type === \"QUEUED\");\r\n      return { posted, queued };\r\n    });\r\n\r\n    onMounted(async () => {\r\n      commit(\"users/info/clearWall\");\r\n      commit(\"users/info/clearPagination\");\r\n      if (!getInfo.value) {\r\n        await dispatch(\"profile/info/apiInfo\");\r\n      }\r\n\r\n      if (!getWall.value.length) {\r\n        setMyWall({ page: getWallPagination.value.page - 1 || 0 });\r\n      }\r\n    });\r\n\r\n    const setMyWall = ({ page }) => {\r\n      if (typeof getInfo.value?.id === \"undefined\") return;\r\n      return dispatch(\"users/info/apiWall\", {\r\n        accountIds: getInfo.value.id,\r\n        author: getInfo.value,\r\n        page,\r\n      });\r\n    };\r\n\r\n    const isActive = (menuItem) => {\r\n      return activeItem.value === menuItem;\r\n    };\r\n    const setActive = (menuItem) => {\r\n      activeItem.value = menuItem;\r\n    };\r\n\r\n    return {\r\n      activeItem,\r\n      translationsLang,\r\n      getInfo,\r\n      getWall,\r\n      getWallQueuedLength,\r\n      getWallPagination,\r\n      loading,\r\n      error,\r\n      errorMessage,\r\n      filteredWall,\r\n      setMyWall,\r\n      isActive,\r\n      setActive,\r\n    };\r\n  },\r\n};\r\n</script>\r\n\r\n<style lang=\"stylus\">\r\n@import '@/assets/stylus/base/vars.styl';\r\n\r\n.profile\r\n  .inner-page__main\r\n    max-width 100%\r\n    margin-right 0\r\n  &__title\r\n    font-family 'Exo', Arial, sans-serif\r\n    font-weight 200\r\n    font-size 30px\r\n    color ui-cl-color-steel-gray\r\n  &__tabs__title\r\n    cursor pointer\r\n    font-family 'Exo', Arial, sans-serif\r\n    font-weight font-weight-bold\r\n    font-size 30px\r\n    margin-bottom 20px\r\n    color ui-cl-color-full-black\r\n\r\n.profile__info-top\r\n  display grid\r\n  gap 50px\r\n  margin-bottom 30px\r\n\r\n.profile__news-list\r\n  display flex\r\n  flex-direction column\r\n  gap 20px\r\n\r\n@media (min-width: 320px) and (max-width: 768px)\r\n  .profile\r\n    &-info\r\n      padding 15px\r\n      flex-direction column\r\n      &__pic\r\n        margin-right 0\r\n        padding-left 0\r\n        padding-right 0\r\n        border-right 0\r\n      &__main\r\n        padding-top 10px\r\n      &__img\r\n        width 100px\r\n        height 100px\r\n      &__name\r\n        margin-bottom 0\r\n        font-size 23px\r\n      &__header\r\n        padding-bottom 10px\r\n        justify-content center\r\n        border-bottom 1px solid ui-cl-color-e6e6e6\r\n        margin-bottom 15px\r\n      &__block\r\n        font-size font-size-small\r\n      &__title\r\n        max-width 125px\r\n      &__block:last-child\r\n        margin-top 20px\r\n    &__info\r\n      margin-bottom 0\r\n      &-top\r\n        grid-template-columns unset\r\n        gap 25px\r\n        margin-bottom 0\r\n    &__news\r\n      margin-top 20px\r\n    &__tabs\r\n      &__title\r\n        font-size font-size-small-medium\r\n        margin-bottom 15px\r\n    &__tab\r\n      font-size font-size-small\r\n</style>\r\n"],"mappings":"AA4FA,SAASA,QAAQ,EAAEC,SAAS,EAAEC,GAAE,QAAS,KAAK;AAC9C,SAASC,QAAO,QAAS,MAAM;AAC/B,OAAOC,eAAc,MAAO,+BAA+B;AAC3D,OAAOC,WAAU,MAAO,2BAA2B;AACnD,OAAOC,OAAM,MAAO,2BAA2B;AAC/C,OAAOC,SAAQ,MAAO,6BAA6B;AACnD,OAAOC,OAAM,MAAO,oCAAoC;AACxD,OAAOC,UAAS,MAAO,6BAA6B;AACpD,OAAOC,aAAY,MAAO,gCAAgC;AAE1D,eAAe;EACbC,IAAI,EAAE,aAAa;EACnBC,UAAU,EAAE;IACVP,WAAW;IACXC,OAAO;IACPC,SAAS;IACTC,OAAO;IACPC,UAAU;IACVC;EACF,CAAC;EAEDG,KAAKA,CAAA,EAAG;IACN,MAAMC,KAAI,GAAIX,QAAQ,CAAC,CAAC;IACxB,MAAM;MAAEY,OAAO;MAAEC,KAAK;MAAEC,QAAQ;MAAEC;IAAO,IAAIJ,KAAK;IAClD,MAAMK,UAAS,GAAIjB,GAAG,CAAC,cAAc,CAAC;IACtC,MAAM;MAAEkB;IAAiB,IAAIhB,eAAe,CAAC,CAAC;IAE9C,MAAMiB,OAAM,GAAIrB,QAAQ,CAAC,MAAMe,OAAO,CAAC,sBAAsB,CAAC,CAAC;IAC/D,MAAMO,OAAM,GAAItB,QAAQ,CAAC,MAAMe,OAAO,CAAC,oBAAoB,CAAC,CAAC;IAC7D,MAAMQ,mBAAkB,GAAIvB,QAAQ,CAClC,MAAMe,OAAO,CAAC,gCAAgC,CAChD,CAAC;IACD,MAAMS,iBAAgB,GAA
{"ast":null,"code":"import { computed } from \"vue\";\nimport { useStore } from \"vuex\";\nexport default {\n  name: \"SearchTabs\",\n  setup() {\n    const {\n      getters,\n      state,\n      dispatch\n    } = useStore();\n    const tabs = computed(() => getters[\"global/search/tabs\"]);\n    const tabSelect = computed(() => getters[\"global/search/tabSelect\"]);\n    const currentTranslations = computed(() => state.auth.languages.language.name);\n    const changeTab = id => {\n      dispatch(\"global/search/changeTab\", id);\n    };\n    return {\n      tabs,\n      tabSelect,\n      currentTranslations,\n      changeTab\n    };\n  }\n};","map":{"version":3,"names":["computed","useStore","name","setup","getters","state","dispatch","tabs","tabSelect","currentTranslations","auth","languages","language","changeTab","id"],"sources":["B:\\develop\\commands_project\\repository\\frontend-vue3\\src\\components\\Search\\Tabs.vue"],"sourcesContent":["<template>\r\n  <ul class=\"search-tabs\">\r\n    <li\r\n      class=\"search-tabs__item\"\r\n      v-for=\"(item, index) in tabs\"\r\n      :key=\"index\"\r\n      :class=\"{ active: item.id === tabSelect }\"\r\n      @click=\"changeTab(item.id)\"\r\n    >\r\n      {{ currentTranslations === \"Русский\" ? item.text : item.textEng }}\r\n    </li>\r\n  </ul>\r\n</template>\r\n\r\n<script>\r\nimport { computed } from \"vue\";\r\nimport { useStore } from \"vuex\";\r\n\r\nexport default {\r\n  name: \"SearchTabs\",\r\n\r\n  setup() {\r\n    const { getters, state, dispatch } = useStore();\r\n\r\n    const tabs = computed(() => getters[\"global/search/tabs\"]);\r\n    const tabSelect = computed(() => getters[\"global/search/tabSelect\"]);\r\n    const currentTranslations = computed(\r\n      () => state.auth.languages.language.name\r\n    );\r\n\r\n    const changeTab = (id) => {\r\n      dispatch(\"global/search/changeTab\", id);\r\n    };\r\n\r\n    return {\r\n      tabs,\r\n      tabSelect,\r\n      currentTranslations,\r\n      changeTab,\r\n    };\r\n  },\r\n};\r\n</script>\r\n\r\n<style lang=\"stylus\">\r\n@import '@/assets/stylus/base/vars.styl';\r\n\r\n.search-tabs\r\n  display flex\r\n  align-items center\r\n  gap 15px\r\n  margin-bottom 15px\r\n\r\n.search-tabs__item\r\n  display inline-block\r\n  text-align center\r\n  color ui-cl-color-eucalypt\r\n  padding 8px 13px\r\n  border 2px solid #21a45d\r\n  transition all 0.2s ease-in-out\r\n  cursor pointer\r\n  &:hover\r\n    background #333\r\n    border-color #333\r\n    color #fff\r\n\r\n  &.active\r\n    color ui-cl-color-white-theme\r\n    background ui-cl-color-eucalypt\r\n    border-color ui-cl-color-eucalypt\r\n    &:hover\r\n      color ui-cl-color-white-theme\r\n      background ui-cl-color-eucalypt\r\n      border-color ui-cl-color-eucalypt\r\n</style>\r\n"],"mappings":"AAeA,SAASA,QAAO,QAAS,KAAK;AAC9B,SAASC,QAAO,QAAS,MAAM;AAE/B,eAAe;EACbC,IAAI,EAAE,YAAY;EAElBC,KAAKA,CAAA,EAAG;IACN,MAAM;MAAEC,OAAO;MAAEC,KAAK;MAAEC;IAAS,IAAIL,QAAQ,CAAC,CAAC;IAE/C,MAAMM,IAAG,GAAIP,QAAQ,CAAC,MAAMI,OAAO,CAAC,oBAAoB,CAAC,CAAC;IAC1D,MAAMI,SAAQ,GAAIR,QAAQ,CAAC,MAAMI,OAAO,CAAC,yBAAyB,CAAC,CAAC;IACpE,MAAMK,mBAAkB,GAAIT,QAAQ,CAClC,MAAMK,KAAK,CAACK,IAAI,CAACC,SAAS,CAACC,QAAQ,CAACV,IACtC,CAAC;IAED,MAAMW,SAAQ,GAAKC,EAAE,IAAK;MACxBR,QAAQ,CAAC,yBAAyB,EAAEQ,EAAE,CAAC;IACzC,CAAC;IAED,OAAO;MACLP,IAAI;MACJC,SAAS;MACTC,mBAAmB;MACnBI;IACF,CAAC;EACH;AACF,CAAC"},"metadata":{},"sourceType":"module","externalDependencies":[]}
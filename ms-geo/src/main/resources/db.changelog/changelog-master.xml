<?xml version="1.0" encoding="UTF-8" ?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
    http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">
    <changeSet id="createTableCountries" author="geo_db">
        <createTable tableName="countries">
            <column name="id" type="SERIAL">
                <constraints primaryKey="true"/>
            </column>
            <column name="country_id" type="UUID NOT NULL"/>
            <column name="is_deleted" type="BOOLEAN" defaultValue="false"/>
            <column name="country_title" type="VARCHAR(85) NOT NULL"/>
        </createTable>
    </changeSet>

    <changeSet id="createTableCities" author="geo_db">
        <createTable tableName="cities">
            <column name="id" type="SERIAL">
                <constraints primaryKey="true"/>
            </column>
            <column name="city_id" type="UUID NOT NULL"/>
            <column name="is_deleted" type="BOOLEAN" defaultValue="false"/>
            <column name="city_title" type="VARCHAR(85)"/>
            <column name="country_id" type="UUID NOT NULL"/>
            <column name="country_title" type="VARCHAR(85) NOT NULL"/>
        </createTable>
    </changeSet>
</databaseChangeLog>
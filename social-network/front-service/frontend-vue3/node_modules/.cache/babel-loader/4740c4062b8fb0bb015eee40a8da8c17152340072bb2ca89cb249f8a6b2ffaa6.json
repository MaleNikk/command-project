m 10px-->\r\n<!--  &__humidity-->\r\n<!--    color #a4a4a4-->\r\n<!--  &__temp-->\r\n<!--    font-size 24px-->\r\n<!--    font-weight font-weight-bold-->\r\n<!--  &__clouds-->\r\n<!--    display flex-->\r\n<!--    align-items center-->\r\n<!--    gap 5px-->\r\n<!--    margin-right 15px-->\r\n<!--  &__minmax-->\r\n<!--    display flex-->\r\n<!--    align-items center-->\r\n<!--    gap 10px-->\r\n<!--    font-size font-size-small-medium-->\r\n<!--    color #000-->\r\n<!--    span-->\r\n<!--      display block-->\r\n<!--      color #a4a4a4-->\r\n\r\n<!--@media (min-width: 320px) and (max-width: 768px)-->\r\n<!--  .weather-->\r\n<!--    display none-->\r\n<!--</style>-->\r\n\r\n<template>\r\n  <div v-if=\"weather\" class=\"weather\">\r\n    <h4 class=\"weather__city\">{{ weather.name }}</h4>\r\n    <div class=\"weather__top\">\r\n      <div class=\"weather__clouds\">\r\n        <img\r\n            :src=\"`https://openweathermap.org/img/wn/${weather.icon}.png`\"\r\n            :alt=\"weather.description\"\r\n        />\r\n        <span class=\"weather__temp\">{{ weather.temp }}°C</span>\r\n      </div>\r\n      <div>\r\n        <div class=\"weather__window\">{{ getNameByIdWeather[0]?.text || weather.description }}</div>\r\n        <div class=\"weather__humidity\">\r\n          {{ translationsLang.weatherHumidity }} {{ weather.humidity }}%\r\n        </div>\r\n        <div class=\"weather__humidity\">\r\n          {{ translationsLang.weatherWind }} {{ weather.windSpeed }}м/с\r\n        </div>\r\n      </div>\r\n    </div>\r\n    <div class=\"weather__minmax\">\r\n      <div>\r\n        {{ translationsLang.weatherMinTemp }}\r\n        <span>{{ weather.temp_min }}°C</span>\r\n      </div>\r\n      <div>\r\n        {{ translationsLang.weatherMaxTemp }}\r\n        <span>{{ weather.temp_max }}°C</span>\r\n      </div>\r\n    </div>\r\n  </div>\r\n  <div class=\"weather\" v-else>\r\n    <p>{{ translationsLang.weatherLoading }}</p>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport { ref, computed, onMounted } from \"vue\";\r\nimport useTranslations from \"@/composables/useTranslations\";\r\nimport translateWeather from \"@/utils/translateWeather\";\r\n\r\nexport default {\r\n  name: \"WeatherBlock\",\r\n\r\n  setup() {\r\n    const weather = ref(null);\r\n    const { translationsLang } = useTranslations();\r\n\r\n    const getNameByIdWeather = computed(() =>\r\n        translateWeather.filter((item) => item.id === weather.value?.id)\r\n    );\r\n\r\n    const getWeather = () => {\r\n      fetch(\"http://ip-api.com/json/\")\r\n          .then((response) => response.json())\r\n          .then((locationData) => {\r\n            if (locationData.status === \"success\") {\r\n              const { lat, lon, city } = locationData;\r\n\r\n              const weatherUrl = `https://api.openweathermap.org/data/2.5/weather?lat=${lat}&lon=${lon}&units=metric&appid=5308edc68a042a4788ed4de34ae08480`;\r\n\r\n              fetch(weatherUrl)\r\n                  .then((response) => response.json())\r\n                  .then((weatherData) => {\r\n                    weather.value = {\r\n                      temp: Math.round(weatherData.main.temp),\r\n                      temp_min: Math.round(weatherData.main.temp_min),\r\n                      temp_max: Math.round(weatherData.main.temp_max),\r\n                      humidity: weatherData.main.humidity,\r\n                      windSpeed: weatherData.wind.speed,\r\n                      icon: weatherData.weather[0].icon,\r\n                      description: weatherData.weather[0].description,\r\n                      id: weatherData.weather[0].id,\r\n                      name: city || weatherData.name,\r\n                    };\r\n                  })\r\n                  .catch((error) => console.error(\"Ошибка получения данных о погоде:\", error));\r\n            } else {\r\n              console.error(\"Не удалось определить местоположение\");\r\n            }\r\n          })\r\n          .catch((error) => console.error(\"Ошибка при запросе местоположения:\", error));\r\n    };\r\n\r\n    onMounted(() => {\r\n      getWeather();\r\n    });\r\n\r\n    return {\r\n      weather,\r\n      translationsLang,\r\n      getNameByIdWeather,\r\n    };\r\n  },\r\n};\r\n</script>\r\n\r\n<style lang=\"stylus\">\r\n@import \"@/assets/stylus/base/vars.styl\";\r\n\r\n.weather\r\n  display flex\r\n  align-items center\r\n  flex-direction column\r\n  justify-content center\r\n  color ui-cl-color-grey-color\r\n  &__city\r\n    font-size 20px\r\n    text-transform uppercase\r\n    font-weight 900\r\n    margin-bottom 10px\r\n  &__title\r\n    color ui-cl-color-grey-color\r\n  &__top\r\n    display flex\r\n    align-items center\r\n    justify-content flex-start\r\n    gap 5px\r\n    font-size font-size-small-medium\r\n    margin-bottom 10px\r\n  &__humidity\r\n    color #a4a4a4\r\n  &__temp\r\n    font-size 24px\r\n    font-weight font-weight-bold\r\n  &__clouds\r\n    display flex\r\n    align-items center\r\n    gap 5px\r\n    margin-right 15px\r\n  &__minmax\r\n    display flex\r\n    align-items center\r\n    gap 10px\r\n    font-size font-size-small-medium\r\n    color #000\r\n    span\r\n      display block\r\n      color #a4a4a4\r\n\r\n@media (min-width: 320px) and (max-width: 768px)\r\n  .weather\r\n    display none\r\n</style>\r\n"],"mappings":"AAsMA,SAASA,GAAG,EAAEC,QAAQ,EAAEC,SAAQ,QAAS,KAAK;AAC9C,OAAOC,eAAc,MAAO,+BAA+B;AAC3D,OAAOC,gBAAe,MAAO,0BAA0B;AAEvD,eAAe;EACbC,IAAI,EAAE,cAAc;EAEpBC,KAAKA,CAAA,EAAG;IACN,MAAMC,OAAM,GAAIP,GAAG,CAAC,IAAI,CAAC;IACzB,MAAM;MAAEQ;IAAiB,IAAIL,eAAe,CAAC,CAAC;IAE9C,MAAMM,kBAAiB,GAAIR,QAAQ,CAAC,MAChCG,gBAAgB,CAACM,MAAM,CAAEC,IAAI,IAAKA,IAAI,CAACC,EAAC,KAAML,OAAO,CAACM,KAAK,EAAED,EAAE,CACnE,CAAC;IAED,MAAME,UAAS,GAAIA,CAAA,KAAM;MACvBC,KAAK,CAAC,yBAAyB,EAC1BC,IAAI,CAAEC,QAAQ,IAAKA,QAAQ,CAACC,IAAI,CAAC,CAAC,EAClCF,IAAI,CAAEG,YAAY,IAAK;QACtB,IAAIA,YAAY,CAACC,MAAK,KAAM,SAAS,EAAE;UACrC,MAAM;YAAEC,GAAG;YAAEC,GAAG;YAAEC;UAAK,IAAIJ,YAAY;UAEvC,MAAMK,UA
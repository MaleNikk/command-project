{"ast":null,"code":"import { ref, watch } from \"vue\";\nimport useTranslations from \"@/composables/useTranslations\";\nexport default {\n  name: \"CodeField\",\n  props: {\n    modelValue: {\n      type: String,\n      default: \"\"\n    },\n    v: {\n      type: Object,\n      required: true\n    },\n    id: {\n      type: String,\n      required: true\n    }\n  },\n  setup(props, {\n    emit\n  }) {\n    const captchaCode = ref(props.modelValue);\n    const {\n      translationsLang\n    } = useTranslations();\n    watch(captchaCode, newVal => {\n      emit(\"update:modelValue\", newVal);\n    });\n    return {\n      captchaCode,\n      translationsLang\n    };\n  }\n};","map":{"version":3,"names":["ref","watch","useTranslations","name","props","modelValue","type","String","default","v","Object","required","id","setup","emit","captchaCode","translationsLang","newVal"],"sources":["G:\\develop\\commands_project\\repository\\frontend-vue3\\src\\components\\FormElements\\CodeField.vue"],"sourcesContent":["<template>\r\n  <div class=\"form__group\" :class=\"{ fill: captchaCode.length > 0 }\">\r\n    <input\r\n      type=\"text\"\r\n      class=\"form__input_stylus\"\r\n      :id=\"id\"\r\n      v-model=\"captchaCode\"\r\n      name=\"code\"\r\n      :class=\"{ invalid: (v.$dirty && !v.required) || (v.$dirty && !v.isCode) }\"\r\n      @change=\"v.$touch()\"\r\n      autocomplete=\"off\"\r\n    />\r\n\r\n    <label :for=\"id\" class=\"form__label_stylus\">{{\r\n      translationsLang.codeTitle\r\n    }}</label>\r\n\r\n    <span class=\"form__error\" v-if=\"v.$dirty && !v.required\">{{\r\n      translationsLang.requiredField\r\n    }}</span>\r\n\r\n    <span class=\"form__error\" v-else-if=\"v.$dirty && !v.isCode\">{{\r\n      translationsLang.codeNoMatch\r\n    }}</span>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport { ref, watch } from \"vue\";\r\nimport useTranslations from \"@/composables/useTranslations\";\r\n\r\nexport default {\r\n  name: \"CodeField\",\r\n  props: {\r\n    modelValue: {\r\n      type: String,\r\n      default: \"\",\r\n    },\r\n    v: {\r\n      type: Object,\r\n      required: true,\r\n    },\r\n    id: {\r\n      type: String,\r\n      required: true,\r\n    },\r\n  },\r\n\r\n  setup(props, { emit }) {\r\n    const captchaCode = ref(props.modelValue);\r\n    const { translationsLang } = useTranslations();\r\n\r\n    watch(captchaCode, (newVal) => {\r\n      emit(\"update:modelValue\", newVal);\r\n    });\r\n\r\n    return {\r\n      captchaCode,\r\n      translationsLang,\r\n    };\r\n  },\r\n};\r\n</script>\r\n"],"mappings":"AA4BA,SAASA,GAAG,EAAEC,KAAI,QAAS,KAAK;AAChC,OAAOC,eAAc,MAAO,+BAA+B;AAE3D,eAAe;EACbC,IAAI,EAAE,WAAW;EACjBC,KAAK,EAAE;IACLC,UAAU,EAAE;MACVC,IAAI,EAAEC,MAAM;MACZC,OAAO,EAAE;IACX,CAAC;IACDC,CAAC,EAAE;MACDH,IAAI,EAAEI,MAAM;MACZC,QAAQ,EAAE;IACZ,CAAC;IACDC,EAAE,EAAE;MACFN,IAAI,EAAEC,MAAM;MACZI,QAAQ,EAAE;IACZ;EACF,CAAC;EAEDE,KAAKA,CAACT,KAAK,EAAE;IAAEU;EAAK,CAAC,EAAE;IACrB,MAAMC,WAAU,GAAIf,GAAG,CAACI,KAAK,CAACC,UAAU,CAAC;IACzC,MAAM;MAAEW;IAAiB,IAAId,eAAe,CAAC,CAAC;IAE9CD,KAAK,CAACc,WAAW,EAAGE,MAAM,IAAK;MAC7BH,IAAI,CAAC,mBAAmB,EAAEG,MAAM,CAAC;IACnC,CAAC,CAAC;IAEF,OAAO;MACLF,WAAW;MACXC;IACF,CAAC;EACH;AACF,CAAC"},"metadata":{},"sourceType":"module","externalDependencies":[]}
{"ast":null,"code":"import { ref, computed } from \"vue\";\nimport { useStore } from \"vuex\";\nimport { useRoute, useRouter } from \"vue-router\";\nimport useTranslations from \"@/composables/useTranslations\";\nimport dayjs from \"dayjs\";\nimport ArrowBottom from \"@/Icons/ArrowBottom.vue\";\nimport AddTags from \"@/components/News/AddTags\";\nexport default {\n  name: \"SearchFilterNews\",\n  components: {\n    AddTags,\n    ArrowBottom\n  },\n  setup() {\n    const {\n      getters,\n      dispatch\n    } = useStore();\n    const route = useRoute();\n    const router = useRouter();\n    const updateTags = ref([]);\n    const dateFrom = ref(\"null\");\n    const dateTo = ref(0);\n    const page = ref(1);\n    const itemPerPage = ref(5);\n    const author = ref(\"\");\n    const showBlock = ref(false);\n    const {\n      translationsLang\n    } = useTranslations();\n    const getNewsQueryParams = computed(() => getters[\"global/search/getNewsQueryParams\"]);\n    const searchText = computed(() => getters[\"global/search/searchText\"]);\n\n    // watch(\n    //   \"$route.query.tags\",\n    //   (newVal) => {\n    //     if (newVal) {\n    //       updateTags.value = newVal.split(\",\");\n    //     }\n    //   },\n    //   { immediate: true }\n    // );\n\n    const onChangeTags = tags => {\n      updateTags.value = tags;\n      const dataTagsSplit = tags.map(tag => tag.name);\n      router.replace({\n        query: {\n          ...route.query,\n          tags: dataTagsSplit.join(\",\")\n        }\n      });\n    };\n    const onSearchNews = () => {\n      const dataTags = updateTags.value;\n      const dataTagsSplit = dataTags.map(tag => tag.name);\n      const dateFromNew = dateFrom.value === \"null\" ? 0 : dayjs().subtract(1, dateFrom.value).valueOf();\n      const dateToNew = dateTo.value = dayjs().format(\"YYYY-MM-DDTHH:mm:ss.SSS[Z]\");\n      const formattedDateFrom = dayjs(dateFromNew).format(\"YYYY-MM-DDTHH:mm:ss.SSS[Z]\");\n      let searchQuery = {\n        ...getNewsQueryParams.value,\n        dateFrom: formattedDateFrom,\n        dateTo: dateToNew,\n        author: author.value,\n        tags: dataTagsSplit.join(\",\"),\n        text: searchText.value,\n        withFriends: true\n      };\n      console.log(formattedDateFrom);\n      console.log(dateToNew);\n      dispatch(\"global/search/searchNews\", searchQuery);\n    };\n    return {\n      updateTags,\n      dateFrom,\n      dateTo,\n      page,\n      itemPerPage,\n      author,\n      showBlock,\n      translationsLang,\n      onChangeTags,\n      onSearchNews\n    };\n  }\n};","map":{"version":3,"names":["ref","computed","useStore","useRoute","useRouter","useTranslations","dayjs","ArrowBottom","AddTags","name","components","setup","getters","dispatch","route","router","updateTags","dateFrom","dateTo","page","itemPerPage","author","showBlock","translationsLang","getNewsQueryParams","searchText","onChangeTags","tags","value","dataTagsSplit","map","tag","replace","query","join","onSearchNews","dataTags","dateFromNew","subtract","valueOf","dateToNew","format","formattedDateFrom","searchQuery","text","withFriends","console","log"],"sources":["G:\\develop\\commands_project\\git_hub\\command_project\\frontend-vue3\\src\\components\\Search\\Filter\\News.vue"],"sourcesContent":["<template>\r\n  <div>\r\n    <button\r\n      class=\"search-showmore-filter\"\r\n      @click.prevent=\"showBlock = !showBlock\"\r\n      :class=\"{ 'open-filter': showBlock }\"\r\n    >\r\n      <span v-if=\"!showBlock\">{{ translationsLang.searchNewsShowMoreButton }}</span>\r\n      <span v-else>{{ translationsLang.searchNewsCloseMoreButton }}</span>\r\n      <arrow-bottom />\r\n    </button>\r\n    <transition name=\"fade\">\r\n      <div class=\"search-filter--news\" v-show=\"showBlock\">\r\n        <div class=\"search-filter\">\r\n          <div class=\"search-filter__block\">\r\n            <label class=\"search__label\" for=\"search-news-author\">{{\r\n              translationsLang.searchNewsAuthor\r\n            }}</label>\r\n            <input\r\n              class=\"search__input search-news-author\"\r\n              type=\"text\"\r\n              :placeholder=\"translationsLang.searchNewsInputPlaceholder\"\r\n              id=\"search-news-author\"\r\n              v-model=\"author\"\r\n            />\r\n          </div>\r\n          <div class=\"search-filter__block time\">\r\n            <label class=\"search__label\">{{\r\n              translationsLang.searchNewsTimePost\r\n            }}</label>\r\n            <select class=\"select search-filter__select\" v-model=\"dateFrom\">\r\n              <option value=\"null\">{{ translationsLang.searchNewsAllTime }}</option>\r\n              <option value=\"year\">\r\n                {{ translationsLang.searchNewsLastYear }}\r\n              </option>\r\n              <option value=\"month\">\r\n                {{ translationsLang.searchNewsLastMonth }}\r\n              </option>\r\n              <option value=\"week\">\r\n                {{ translationsLang.searchNewsLastWeek }}\r\n              </option>\r\n            </select>\r\n          </div>\r\n          <div class=\"search-filter__block tags\">\r\n            <label class=\"search__label\">{{\r\n              translationsLang.searchNewsTag\r\n            }}</label>\r\n            <add-tags\r\n              :allowManualAddition=\"false\"\r\n              :tags=\"updateTags\"\r\n              @change-tags=\"onChangeTags\"\r\n            />\r\n          </div>\r\n        </div>\r\n        <div class=\"search-filter__block btn-news\">\r\n          <button class=\"search-filter__btn\" @click.prevent=\"onSearchNews\">\r\n            {{ translationsLang.searchNewsBtnComplited }}\r\n          </button>\r\n        </div>\r\n      </div>\r\n    </transition>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport { ref, computed } from \"vue\";\r\nimport { useStore } from \"vuex\";\r\nimport { useRoute, useRouter } from \"vue-router\";\r\nimport useTranslations from \"@/composables/useTranslations\";\r\nimport dayjs from \"dayjs\";\r\nimport ArrowBottom from \"@/Icons/ArrowBottom.vue\";\r\nimport AddTags from \"@/components/News/AddTags\";\r\n\r\nexport default {\r\n  name: \"SearchFilterNews\",\r\n  components: { AddTags, ArrowBottom },\r\n\r\n  setup() {\r\n    const { getters, dispatch } = useStore();\r\n    const route = useRoute();\r\n    const router = useRouter();\r\n    const updateTags = ref([]);\r\n    const dateFrom = ref(\"null\");\r\n    const dateTo = ref(0);\r\n    const page = ref(1);\r\n    const itemPerPage = ref(5);\r\n    const author = ref(\"\");\r\n    const showBlock = ref(false);\r\n    const { translationsLang } = useTranslations();\r\n\r\n    const getNewsQueryParams = computed(\r\n      () => getters[\"global/search/getNewsQueryParams\"]\r\n    );\r\n    const searchText = computed(() => getters[\"global/search/searchText\"]);\r\n\r\n    // watch(\r\n    //   \"$route.query.tags\",\r\n    //   (newVal) => {\r\n    //     if (newVal) {\r\n    //       updateTags.value = newVal.split(\",\");\r\n    //     }\r\n    //   },\r\n    //   { immediate: true }\r\n    // );\r\n\r\n    const onChangeTags = (tags) => {\r\n      updateTags.value = tags;\r\n      const dataTagsSplit = tags.map((tag) => tag.name);\r\n      router.replace({\r\n        query: {\r\n          ...route.query,\r\n          tags: dataTagsSplit.join(\",\"),\r\n        },\r\n      });\r\n    };\r\n\r\n    const onSearchNews = () => {\r\n      const dataTags = updateTags.value;\r\n      const dataTagsSplit = dataTags.map((tag) => tag.name);\r\n      const dateFromNew =\r\n        dateFrom.value === \"null\" ? 0 : dayjs().subtract(1, dateFrom.value).valueOf();\r\n      const dateToNew = (dateTo.value = dayjs().format(\r\n        \"YYYY-MM-DDTHH:mm:ss.SSS[Z]\"\r\n      ));\r\n      const formattedDateFrom = dayjs(dateFromNew).format(\r\n        \"YYYY-MM-DDTHH:mm:ss.SSS[Z]\"\r\n      );\r\n      let searchQuery = {\r\n        ...getNewsQueryParams.value,\r\n        dateFrom: formattedDateFrom,\r\n        dateTo: dateToNew,\r\n        author: author.value,\r\n        tags: dataTagsSplit.join(\",\"),\r\n        text: searchText.value,\r\n        withFriends: true,\r\n      };\r\n      console.log(formattedDateFrom);\r\n      console.log(dateToNew);\r\n      dispatch(\"global/search/searchNews\", searchQuery);\r\n    };\r\n\r\n    return {\r\n      updateTags,\r\n      dateFrom,\r\n      dateTo,\r\n      page,\r\n      itemPerPage,\r\n      author,\r\n      showBlock,\r\n      translationsLang,\r\n      onChangeTags,\r\n      onSearchNews,\r\n    };\r\n  },\r\n};\r\n</script>\r\n\r\n<style lang=\"stylus\">\r\n@import '@/assets/stylus/base/vars.styl';\r\n\r\n  .search-filter--news\r\n    &.fade-enter-active,\r\n    &.fade-leave-active\r\n      transition all .2s ease-in-out\r\n    &.fade-enter,\r\n    &.fade-leave-to\r\n      opacity 0\r\n\r\n  .search-news-author\r\n    width 200px\r\n  .search-filter__block .add-tags__search-results\r\n    top 100%\r\n    border-radius border-super-small\r\n    max-width 200px\r\n</style>\r\n"],"mappings":"AAiEA,SAASA,GAAG,EAAEC,QAAO,QAAS,KAAK;AACnC,SAASC,QAAO,QAAS,MAAM;AAC/B,SAASC,QAAQ,EAAEC,SAAQ,QAAS,YAAY;AAChD,OAAOC,eAAc,MAAO,+BAA+B;AAC3D,OAAOC,KAAI,MAAO,OAAO;AACzB,OAAOC,WAAU,MAAO,yBAAyB;AACjD,OAAOC,OAAM,MAAO,2BAA2B;AAE/C,eAAe;EACbC,IAAI,EAAE,kBAAkB;EACxBC,UAAU,EAAE;IAAEF,OAAO;IAAED;EAAY,CAAC;EAEpCI,KAAKA,CAAA,EAAG;IACN,MAAM;MAAEC,OAAO;MAAEC;IAAS,IAAIX,QAAQ,CAAC,CAAC;IACxC,MAAMY,KAAI,GAAIX,QAAQ,CAAC,CAAC;IACxB,MAAMY,MAAK,GAAIX,SAAS,CAAC,CAAC;IAC1B,MAAMY,UAAS,GAAIhB,GAAG,CAAC,EAAE,CAAC;IAC1B,MAAMiB,QAAO,GAAIjB,GAAG,CAAC,MAAM,CAAC;IAC5B,MAAMkB,MAAK,GAAIlB,GAAG,CAAC,CAAC,CAAC;IACrB,MAAMmB,IAAG,GAAInB,GAAG,CAAC,CAAC,CAAC;IACnB,MAAMoB,WAAU,GAAIpB,GAAG,CAAC,CAAC,CAAC;IAC1B,MAAMqB,MAAK,GAAIrB,GAAG,CAAC,EAAE,CAAC;IACtB,MAAMsB,SAAQ,GAAItB,GAAG,CAAC,KAAK,CAAC;IAC5B,MAAM;MAAEuB;IAAiB,IAAIlB,eAAe,CAAC,CAAC;IAE9C,MAAMmB,kBAAiB,GAAIvB,QAAQ,CACjC,MAAMW,OAAO,CA
{"ast":null,"code":"import { ref, computed, watch } from \"vue\";\nimport useTranslations from \"@/composables/useTranslations\";\nexport default {\n  name: \"PasswordField\",\n  props: {\n    modelValue: {\n      type: String,\n      default: \"\"\n    },\n    v: {\n      type: Object,\n      required: true\n    },\n    info: Boolean,\n    registration: Boolean,\n    id: {\n      type: String,\n      required: true\n    }\n  },\n  setup(props, {\n    emit\n  }) {\n    const passwordFieldType = ref(\"password\");\n    const passwordHelperShow = ref(true);\n    const password = ref(props.modelValue);\n    const {\n      translationsLang\n    } = useTranslations();\n    const levelInfo = computed(() => {\n      if (!passwordHelperShow.value) {\n        return {\n          text: null,\n          class: null\n        };\n      }\n      if (password.value.length >= 3 && password.value.length < 7) {\n        return {\n          text: translationsLang.passLevelFirst,\n          class: \"easy\"\n        };\n      }\n      if (password.value.length >= 7 && password.value.length < 11) {\n        return {\n          text: translationsLang.passLevelSecond,\n          class: \"midle\"\n        };\n      }\n      if (password.value.length > 11) {\n        return {\n          text: translationsLang.passLevelTree,\n          class: \"hard\"\n        };\n      }\n      return {\n        text: null,\n        class: null\n      };\n    });\n    const updateValue = Value => {\n      password.value = Value;\n      emit(\"update:modelValue\", Value);\n    };\n    const switchVisibility = () => {\n      passwordFieldType.value = passwordFieldType.value === \"password\" ? \"text\" : \"password\";\n    };\n    const passwordBlur = () => {\n      passwordHelperShow.value = false;\n      props.v.$touch();\n    };\n    watch(password, newVal => {\n      emit(\"update:modelValue\", newVal);\n    });\n    return {\n      password,\n      translationsLang,\n      switchVisibility,\n      passwordBlur,\n      updateValue,\n      levelInfo,\n      passwordFieldType\n    };\n  }\n};","map":{"version":3,"names":["ref","computed","watch","useTranslations","name","props","modelValue","type","String","default","v","Object","required","info","Boolean","registration","id","setup","emit","passwordFieldType","passwordHelperShow","password","translationsLang","levelInfo","value","text","class","length","passLevelFirst","passLevelSecond","passLevelTree","updateValue","Value","switchVisibility","passwordBlur","$touch","newVal"],"sources":["B:\\develop\\commands_project\\repository\\frontend-vue3\\src\\components\\FormElements\\PasswordField.vue"],"sourcesContent":["<template>\r\n  <div class=\"form__group\" :class=\"{ fill: password.length > 0 }\">\r\n    <label class=\"form__label_stylus\" :for=\"id\">{{\r\n      translationsLang.passLogin\r\n    }}</label>\r\n\r\n    <input\r\n      class=\"form__input_stylus\"\r\n      name=\"password\"\r\n      :id=\"id\"\r\n      :type=\"passwordFieldType\"\r\n      :value=\"modelValue\"\r\n      @input=\"updateValue($event.target.value)\"\r\n      @change=\"passwordBlur()\"\r\n      :class=\"{\r\n        invalid: (v.$dirty && !v.required) || (v.$dirty && !v.minLength),\r\n      }\"\r\n      pattern=\"[A-Za-z0-9!@#$%^&*]+\"\r\n      autocomplete=\"current-password\"\r\n    />\r\n\r\n    <span class=\"form__error\" v-if=\"v.$dirty && !v.required\">{{\r\n      translationsLang.passLoginEnter\r\n    }}</span>\r\n\r\n    <div class=\"form__error-block_\">\r\n      <div v-if=\"registration\">\r\n        <span class=\"form__password-helper\" :class=\"levelInfo.class\" />\r\n        <span class=\"form__error\" v-if=\"password.length >= 3\">\r\n          {{ levelInfo.text }}\r\n        </span>\r\n      </div>\r\n\r\n      <div v-else>\r\n        <span class=\"form__error\" v-if=\"v.$dirty && !v.minLength\">\r\n          {{ translationsLang.validatePass1 }}\r\n          {{ v.$params.minLength.min }}\r\n          {{ translationsLang.validatePass2 }}\r\n          {{ password.length }}\r\n        </span>\r\n      </div>\r\n    </div>\r\n\r\n    <div v-if=\"info\">\r\n      <div class=\"form__password-icon active\">\r\n        <img src=\"@/assets/static/img/password-info.svg\" alt=\"img.svg\" />\r\n      </div>\r\n\r\n      <p class=\"form__password-info\">\r\n        {{ translationsLang.passInfo }}\r\n      </p>\r\n    </div>\r\n\r\n    <div\r\n      class=\"form__password-icon\"\r\n      :class=\"{ active: password.length > 0 }\"\r\n      @keydown=\"switchVisibility\"\r\n      @click=\"switchVisibility\"\r\n      v-if=\"!registration\"\r\n    >\r\n      <img src=\"@/assets/static/img/password-eye.svg\" alt=\"img.svg\" />\r\n    </div>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport { ref, computed, watch } from \"vue\";\r\nimport useTranslations from \"@/composables/useTranslations\";\r\n\r\nexport default {\r\n  name: \"PasswordField\",\r\n  props: {\r\n    modelValue: {\r\n      type: String,\r\n      default: \"\",\r\n    },\r\n    v: {\r\n      type: Object,\r\n      required: true,\r\n    },\r\n    info: Boolean,\r\n    registration: Boolean,\r\n    id: {\r\n      type: String,\r\n      required: true,\r\n    },\r\n  },\r\n\r\n  setup(props, { emit }) {\r\n    const passwordFieldType = ref(\"password\");\r\n    const passwordHelperShow = ref(true);\r\n    const password = ref(props.modelValue);\r\n    const { translationsLang } = useTranslations();\r\n\r\n    const levelInfo = computed(() => {\r\n      if (!passwordHelperShow.value) {\r\n        return { text: null, class: null };\r\n      }\r\n      if (password.value.length >= 3 && password.value.length < 7) {\r\n        return { text: translationsLang.passLevelFirst, class: \"easy\" };\r\n      }\r\n      if (password.value.length >= 7 && password.value.length < 11) {\r\n        return { text: translationsLang.passLevelSecond, class: \"midle\" };\r\n      }\r\n      if (password.value.length > 11) {\r\n        return { text: translationsLang.passLevelTree, class: \"hard\" };\r\n      }\r\n      return { text: null, class: null };\r\n    });\r\n\r\n    const updateValue = (Value) => {\r\n      password.value = Value;\r\n      emit(\"update:modelValue\", Value);\r\n    };\r\n\r\n    const switchVisibility = () => {\r\n      passwordFieldType.value =\r\n        passwordFieldType.value === \"password\" ? \"text\" : \"password\";\r\n    };\r\n\r\n    const passwordBlur = () => {\r\n      passwordHelperShow.value = false;\r\n      props.v.$touch();\r\n    };\r\n\r\n    watch(password, (newVal) => {\r\n      emit(\"update:modelValue\", newVal);\r\n    });\r\n\r\n    return {\r\n      password,\r\n      translationsLang,\r\n      switchVisibility,\r\n      passwordBlur,\r\n      updateValue,\r\n      levelInfo,\r\n      passwordFieldType,\r\n    };\r\n  },\r\n};\r\n</script>\r\n"],"mappings":"AAkEA,SAASA,GAAG,EAAEC,QAAQ,EAAEC,KAAI,QAAS,KAAK;AAC1C,OAAOC,eAAc,MAAO,+BAA+B;AAE3D,eAAe;EACbC,IAAI,EAAE,eAAe;EACrBC,KAAK,EAAE;IACLC,UAAU,EAAE;MACVC,IAAI,EAAEC,MAAM;MACZC,OAAO,EAAE;IACX,CAAC;IACDC,CAAC,EAAE;MACDH,IAAI,EAAEI,MAAM;MACZC,QAAQ,EAAE;IACZ,CAAC;IACDC,IAAI,EAAEC,OAAO;IACbC,YAAY,EAAED,OAAO;IACrBE,EAAE,EAAE;MACFT,IAAI,EAAEC,MAAM;MACZI,QAAQ,EAAE;IACZ;EACF,CAAC;EAEDK,KAAKA,CAACZ,KAAK,EAAE;IAAEa;EAAK,CAAC,EAAE;IACrB,MAAMC,iBAAgB,GAAInB,GAAG,CAAC,UAAU,CAAC;IACzC,MAAMoB,kBAAiB,GAAIpB,GAAG,CAAC,IAAI,CAAC;IACpC,MAAMqB,QAAO,GAAIrB,GAAG,CAACK,KAAK,CAACC,UAAU,CAAC;IACtC,MAAM;MAAEgB;IAAiB,IAAInB,eAAe,CAAC,CAAC;IAE9C,MAAMoB,SAAQ,GAAItB,QAAQ,CAAC,MAAM;MAC/B,IAAI,CAACmB,kBAAkB,CAACI,KAAK,EAAE;QAC7B,OAAO;UAAEC,IAAI,EAAE,IAAI;UAAEC,KAAK,EAAE;QAAK,CAAC;MACpC;MACA,IAAIL,QAAQ,CAACG,KAAK,CAACG,MAAK,IAAK,KAAKN,QAAQ,CAACG,KAAK,CAACG,MAAK,GAAI,CAAC,EAAE;QAC3D,OAAO;UAAEF,IAAI,EAAEH,gBAAgB,CAACM,cAAc;UAAEF,KAAK,EAAE;QAAO,CAAC;MACjE;MACA,IAAIL,QAAQ,CAACG,KAAK,CAACG,MAAK,IAAK,KAAKN,QAAQ,CAACG,KAAK,CAACG,MAAK,GAAI,EAAE,EAAE;QAC5D,OAAO;UAAEF,IAAI,EAAEH,gBAAgB,CAACO,eAAe;UAAEH,KAAK,EAAE;QAAQ,CAAC;MACnE;MACA,IAAIL,QAAQ,CAACG,KAAK,CAACG,MAAK,GAAI
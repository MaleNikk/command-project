{"ast":null,"code":"import { ref, computed } from 'vue';\nimport { useStore } from 'vuex';\nimport useTranslations from '@/composables/useTranslations';\nimport AddIcon from '@/Icons/AddIcon.vue';\nimport AddForm from '@/components/News/AddForm.vue';\nimport UnknowUser from '@/Icons/UnknowUser.vue';\nexport default {\n  name: \"NewsAdd\",\n  components: {\n    AddForm,\n    AddIcon,\n    UnknowUser\n  },\n  props: {\n    user: Boolean\n  },\n  setup() {\n    const store = useStore();\n    const isOpen = ref(false);\n    const {\n      translationsLang\n    } = useTranslations();\n    const getInfo = computed(() => store.getters[\"profile/info/getInfo\"]);\n    const fullName = computed(() => `${getInfo.value.firstName[0]} ${getInfo.value.lastName[0]}`);\n    const openForm = () => {\n      isOpen.value = true;\n    };\n    const closeForm = () => {\n      isOpen.value = false;\n    };\n    return {\n      isOpen,\n      translationsLang,\n      getInfo,\n      fullName,\n      openForm,\n      closeForm\n    };\n  }\n};","map":{"version":3,"names":["ref","computed","useStore","useTranslations","AddIcon","AddForm","UnknowUser","name","components","props","user","Boolean","setup","store","isOpen","translationsLang","getInfo","getters","fullName","value","firstName","lastName","openForm","closeForm"],"sources":["G:\\develop\\commands_project\\git_hub\\command_project\\frontend-vue3\\src\\components\\News\\Add.vue"],"sourcesContent":["<template>\r\n  <div class=\"news-add\" :class=\"{ open: isOpen }\">\r\n    <div class=\"news-add__mask\" v-if=\"!isOpen\" @click.prevent=\"openForm()\">\r\n      <template v-if=\"getInfo\">\r\n        <div class=\"news-add__pic imgDiv\" v-if=\"user\">\r\n          <img\r\n            v-if=\"getInfo.photo\"\r\n            class=\"avatar\"\r\n            :src=\"getInfo.photo\"\r\n            :alt=\"fullName\"\r\n          />\r\n\r\n          <div class=\"avatar\" v-else>\r\n            <unknow-user />\r\n          </div>\r\n        </div>\r\n      </template>\r\n\r\n      <span class=\"news-add__placeholder\">{{\r\n        translationsLang.newsAddPlaceholder\r\n      }}</span>\r\n\r\n      <div class=\"news-add__block add\" @click.prevent=\"openForm()\">\r\n        <add-icon />\r\n      </div>\r\n    </div>\r\n\r\n    <add-form v-else @submit-complete=\"closeForm\" @close-form=\"closeForm\" />\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport { ref, computed } from 'vue';\r\nimport { useStore } from 'vuex';\r\nimport useTranslations from '@/composables/useTranslations';\r\nimport AddIcon from '@/Icons/AddIcon.vue';\r\nimport AddForm from '@/components/News/AddForm.vue';\r\nimport UnknowUser from '@/Icons/UnknowUser.vue';\r\n\r\nexport default {\r\n  name: \"NewsAdd\",\r\n  components: {\r\n    AddForm,\r\n    AddIcon,\r\n    UnknowUser,\r\n  },\r\n  props: {\r\n    user: Boolean,\r\n  },\r\n\r\n  setup() {\r\n    const store = useStore();\r\n    const isOpen = ref(false);\r\n    const { translationsLang } = useTranslations();\r\n\r\n    const getInfo = computed(() => store.getters[\"profile/info/getInfo\"]);\r\n    const fullName = computed(\r\n      () => `${getInfo.value.firstName[0]} ${getInfo.value.lastName[0]}`\r\n    );\r\n\r\n    const openForm = () => {\r\n      isOpen.value = true;\r\n    };\r\n    const closeForm = () => {\r\n      isOpen.value = false;\r\n    };\r\n\r\n    return {\r\n      isOpen,\r\n      translationsLang,\r\n      getInfo,\r\n      fullName,\r\n      openForm,\r\n      closeForm,\r\n    };\r\n  },\r\n};\r\n</script>\r\n\r\n<style lang=\"stylus\">\r\n@import '@/assets/stylus/base/vars.styl';\r\n\r\n@media (min-width: 320px) and (max-width: 768px)\r\n  .news-add\r\n    &__mask\r\n      padding 10px 20px\r\n      height unset\r\n    &__text-title\r\n      font-size font-size-updefault\r\n      padding-bottom 10px\r\n</style>\r\n\r\n<style lang=\"stylus\" scoped>\r\n.avatar\r\n  display flex\r\n  align-items center\r\n  justify-content center\r\n  width 100%\r\n  height 100%\r\n  object-fit cover\r\n\r\n.imgDiv\r\n  background-color #bcdfc7\r\n</style>\r\n"],"mappings":"AAgCA,SAASA,GAAG,EAAEC,QAAO,QAAS,KAAK;AACnC,SAASC,QAAO,QAAS,MAAM;AAC/B,OAAOC,eAAc,MAAO,+BAA+B;AAC3D,OAAOC,OAAM,MAAO,qBAAqB;AACzC,OAAOC,OAAM,MAAO,+BAA+B;AACnD,OAAOC,UAAS,MAAO,wBAAwB;AAE/C,eAAe;EACbC,IAAI,EAAE,SAAS;EACfC,UAAU,EAAE;IACVH,OAAO;IACPD,OAAO;IACPE;EACF,CAAC;EACDG,KAAK,EAAE;IACLC,IAAI,EAAEC;EACR,CAAC;EAEDC,KAAKA,CAAA,EAAG;IACN,MAAMC,KAAI,GAAIX,QAAQ,CAAC,CAAC;IACxB,MAAMY,MAAK,GAAId,GAAG,CAAC,KAAK,CAAC;IACzB,MAAM;MAAEe;IAAiB,IAAIZ,eAAe,CAAC,CAAC;IAE9C,MAAMa,OAAM,GAAIf,QAAQ,CAAC,MAAMY,KAAK,CAACI,OAAO,CAAC,sBAAsB,CAAC,CAAC;IACrE,MAAMC,QAAO,GAAIjB,QAAQ,CACvB,MAAO,GAAEe,OAAO,CAACG,KAAK,CAACC,SAAS,CAAC,CAAC,CAAC,IAAIJ,OAAO,CAACG,KAAK,CAACE,QAAQ,CAAC,CAAC,CAAE,EACnE,CAAC;IAED,MAAMC,QAAO,GAAIA,CAAA,KAAM;MACrBR,MAAM,CAACK,KAAI,GAAI,IAAI;IACrB,CAAC;IACD,MAAMI,SAAQ,GAAIA,CAAA,KAAM;MACtBT,MAAM,CAACK,KAAI,GAAI,KAAK;IACtB,CAAC;IAED,OAAO;MACLL,MAAM;MACNC,gBAAgB;MAChBC,OAAO;MACPE,QAAQ;MACRI,QAAQ;MACRC;IACF,CAAC;EACH;AACF,CAAC"},"metadata":{},"sourceType":"module","externalDependencies":[]}
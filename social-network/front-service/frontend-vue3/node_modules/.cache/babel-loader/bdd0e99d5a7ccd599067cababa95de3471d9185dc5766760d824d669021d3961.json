>\r\n<!--      getWeather,-->\r\n<!--    };-->\r\n<!--  },-->\r\n<!--};-->\r\n<!--</script>-->\r\n\r\n<!--<style lang=\"stylus\">-->\r\n<!--@import '@/assets/stylus/base/vars.styl';-->\r\n\r\n<!--.weather-->\r\n<!--  display flex-->\r\n<!--  align-items center-->\r\n<!--  flex-direction column-->\r\n<!--  justify-content center-->\r\n<!--  color ui-cl-color-grey-color-->\r\n<!--  &__city-->\r\n<!--    font-size 20px-->\r\n<!--    text-transform uppercase-->\r\n<!--    font-weight 900-->\r\n<!--    margin-bottom 10px-->\r\n<!--  &__title-->\r\n<!--    color ui-cl-color-grey-color-->\r\n<!--  &__top-->\r\n<!--    display flex-->\r\n<!--    align-items center-->\r\n<!--    justify-content flex-start-->\r\n<!--    gap 5px-->\r\n<!--    font-size font-size-small-medium-->\r\n<!--    margin-bottom 10px-->\r\n<!--  &__humidity-->\r\n<!--    color #a4a4a4-->\r\n<!--  &__temp-->\r\n<!--    font-size 24px-->\r\n<!--    font-weight font-weight-bold-->\r\n<!--  &__clouds-->\r\n<!--    display flex-->\r\n<!--    align-items center-->\r\n<!--    gap 5px-->\r\n<!--    margin-right 15px-->\r\n<!--  &__minmax-->\r\n<!--    display flex-->\r\n<!--    align-items center-->\r\n<!--    gap 10px-->\r\n<!--    font-size font-size-small-medium-->\r\n<!--    color #000-->\r\n<!--    span-->\r\n<!--      display block-->\r\n<!--      color #a4a4a4-->\r\n\r\n<!--@media (min-width: 320px) and (max-width: 768px)-->\r\n<!--  .weather-->\r\n<!--    display none-->\r\n<!--</style>-->\r\n\r\n<template>\r\n  <div v-if=\"weather\" class=\"weather\">\r\n    <h4 class=\"weather__city\">{{ weather.name }}</h4>\r\n    <div class=\"weather__top\">\r\n      <div class=\"weather__clouds\">\r\n        <img\r\n            :src=\"`https://openweathermap.org/img/wn/${weather.icon}.png`\"\r\n            :alt=\"weather.description\"\r\n        />\r\n        <span class=\"weather__temp\">{{ weather.temp }}°C</span>\r\n      </div>\r\n      <div>\r\n        <div class=\"weather__window\">{{ getNameByIdWeather[0]?.text || weather.description }}</div>\r\n        <div class=\"weather__humidity\">\r\n          {{ translationsLang.weatherHumidity }} {{ weather.humidity }}%\r\n        </div>\r\n        <div class=\"weather__humidity\">\r\n          {{ translationsLang.weatherWind }} {{ weather.windSpeed }}м/с\r\n        </div>\r\n      </div>\r\n    </div>\r\n    <div class=\"weather__minmax\">\r\n      <div>\r\n        {{ translationsLang.weatherMinTemp }}\r\n        <span>{{ weather.temp_min }}°C</span>\r\n      </div>\r\n      <div>\r\n        {{ translationsLang.weatherMaxTemp }}\r\n        <span>{{ weather.temp_max }}°C</span>\r\n      </div>\r\n    </div>\r\n  </div>\r\n  <div class=\"weather\" v-else>\r\n    <p>{{ translationsLang.weatherLoading }}</p>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport { ref, computed, onMounted } from \"vue\";\r\nimport useTranslations from \"@/composables/useTranslations\";\r\nimport translateWeather from \"@/utils/translateWeather\";\r\n\r\nexport default {\r\n  name: \"WeatherBlock\",\r\n\r\n  setup() {\r\n    const weather = ref(null);\r\n    const { translationsLang } = useTranslations();\r\n\r\n    const getNameByIdWeather = computed(() =>\r\n        translateWeather.filter((item) => item.id === weather.value?.id)\r\n    );\r\n\r\n    const getWeather = () => {\r\n      fetch(\"http://ip-api.com/json/\")\r\n          .then((response) => response.json())\r\n          .then((locationData) => {\r\n            if (locationData.status === \"success\") {\r\n              const { lat, lon, city } = locationData;\r\n\r\n              const weatherUrl = `https://api.openweathermap.org/data/2.5/weather?lat=${lat}&lon=${lon}&units=metric&appid=5308edc68a042a4788ed4de34ae08480`;\r\n\r\n              fetch(weatherUrl)\r\n                  .then((response) => response.json())\r\n                  .then((weatherData) => {\r\n                    weather.value = {\r\n                      temp: Math.round(weatherData.main.temp),\r\n                      temp_min: Math.round(weatherData.main.temp_min),\r\n                      temp_max: Math.round(weatherData.main.temp_max),\r\n                      humidity: weatherData.main.humidity,\r\n                      windSpeed: weatherData.wind.speed,\r\n                      icon: weatherData.weather[0].icon,\r\n                      description: weatherData.weather[0].description,\r\n                      id: weatherData.weather[0].id,\r\n                      name: city || weatherData.name,\r\n                    };\r\n                  })\r\n                  .catch((error) => console.error(\"Ошибка получения данных о погоде:\", error));\r\n            } else {\r\n              console.error(\"Не удалось определить местоположение\");\r\n            }\r\n          })\r\n          .catch((error) => console.error(\"Ошибка при запросе местоположения:\", error));\r\n    };\r\n\r\n    onMounted(() => {\r\n      getWeather();\r\n    });\r\n\r\n    return {\r\n      weather,\r\n      translationsLang,\r\n      getNameByIdWeather,\r\n    };\r\n  },\r\n};\r\n</script>\r\n\r\n<style lang=\"stylus\">\r\n@import \"@/assets/stylus/base/vars.styl\";\r\n\r\n.weather\r\n  display flex\r\n  align-items center\r\n  flex-direction column\r\n  justify-content center\r\n  color ui-cl-color-grey-color\r\n  &__city\r\n    font-size 20px\r\n    text-transform uppercase\r\n    font-weight 900\r\n    margin-bottom 10px\r\n  &__title\r\n    color ui-cl-color-grey-color\r\n  &__top\r\n    display flex\r\n    align-items center\r\n    justify-content flex-start\r\n    gap 5px\r\n    font-size font-size-small-medium\r\n    margin-bottom 10px\r\n  &__humidity\r\n    color #a4a4a4\r\n  &__temp\r\n    font-size 24px\r\n    font-weight font-weight-bold\r\n  &__clouds\r\n    display flex\r\n    align-items center\r\n    gap 5px\r\n    margin-right 15px\r\n  &__minmax\r\n    display flex\r\n    align-items center\r\n    gap 10px\r\n    font-size font-size-small-medium\r\n    color #000\r\n    span\r\n      display block\r\n      color #a4a4a4\r\n\r\n@media (min-width: 320px) and (max-width: 768px)\r\n  .weather\r\n    display none\r\n</style>\r\n"],"mappings":";;;EAiKsBA,KAAK,EAAC;;;EACpBA,KAAK,EAAC;AAAe;;EACpBA,KAAK,EAAC;AAAc;;EAClBA,KAAK,EAAC;AAAiB;;;EAKpBA,KAAK,EAAC;AAAe;;EAGtBA,KAAK,EAAC;AAAiB;;EACvBA,KAAK,EAAC;AAAmB;;EAGzBA,KAAK,EAAC;AAAmB;;EAK7BA,KAAK,EAAC;AAAiB;;;EAWzBA,KAAK,EAAC;;;SA/BAC,MAAA,CAAAC,OAAO,I,cAAlBC,mBAAA,CA8BM,OA9BNC,UA8BM,GA7BJC,mBAAA,CAAiD,MAAjDC,UAAiD,EAAAC,gBAAA,CAApBN,MAAA,CAAAC,OAAO,CAACM,IAAI,kBACzCH,mBAAA,CAiBM,OAjBNI,UAiBM,GAhBJJ,mBAAA,CAMM,OANNK,UAMM,GALJL,mBAAA,CAGE;IAFGM,GAAG,uCAAuCV,MAAA,CAAAC,OAAO,CAACU,IAAI;IACtDC,GAAG,EAAEZ,MAAA,CAAAC,OAAO,CAACY;uCAElBT,mBAAA,CAAuD,QAAvDU,UAAuD,EAAAR,gBAAA,CAAxBN,MAAA,CAAAC,OAAO,CAACc,IAAI,IAAG,IAAE,gB,GAElDX,mBAAA,CAQM,cAPJA,mBAAA,CAA2F,OAA3FY,UAA2F,EAAAV,gBAAA,CAA3DN,MAAA,CAAAiB,kBAAkB,KAAKC,IAAI,IAAIlB,MAAA,CAAAC,OAAO,CAACY,WAAW,kBAClFT,mBAAA,CAEM,OAFNe,UAEM,EAAAb,gBAAA,CADDN,MAAA,CAAAoB,gBAAgB,CAACC,eAAe,IAAG,GAAC,GAAAf,gBAAA,CAAGN,MAAA,CAAAC,OAAO,CAACqB,QAAQ,IAAG,IAC/D,iBACAlB,mBAAA,CAEM,OAFNmB,UAEM,EAAAjB,gBAAA,CADDN,MAAA,CAAAoB,gBAAgB,CAACI,WAAW,IAAG,GAAC,GAAAlB,gBAAA,CAAGN,MAAA,CAAAC,OAAO,CAACwB,SAAS,IAAG,MAC5D,gB,KAGJrB,mBAAA,CASM,OATNsB,WASM,GARJtB,mBAAA,CAGM,c,kCAFDJ,MAAA,CAAAoB,gBAAgB,CAACO,cAAc,IAAG,GACrC,iBAAAvB,mBAAA,CAAqC,cAAAE,gBAAA,CAA5BN,MAAA,CAAAC,OAAO,CAAC2B,QAAQ,IAAG,IAAE,gB,GAEhCxB,mBAAA,CAGM,c,kCAFDJ,MAAA,CAAAoB,gBAAgB,CAACS,cAAc,IAAG,GACrC,iBAAAzB,mBAAA,CAAqC,cAAAE,gBAAA,CAA5BN,MAAA,CAAAC,OAAO,CAAC6B,QAAQ,IAAG,IAAE,gB,wBAIpC5B,mBAAA,CAEM,OAFN6B,WAEM,GADJ3B,mBAAA,CAA4C,WAAAE,gBAAA,CAAtCN,MAAA,CAAAoB,gBAAgB,CAACY,cAAc,iB"},"metadata":{},"sourceType":"module","externalDependencies":[]}
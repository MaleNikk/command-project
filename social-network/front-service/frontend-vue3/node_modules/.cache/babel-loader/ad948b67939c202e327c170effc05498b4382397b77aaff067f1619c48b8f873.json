{"ast":null,"code":"import { computed } from \"vue\";\nexport default {\n  props: [\"page\", \"count\", \"perPage\"],\n  setup(props, {\n    emit\n  }) {\n    const pages = computed(() => Math.ceil(props.count / props.perPage));\n    const prevPage = computed(() => {\n      if (props.page === 1) {\n        return props.page;\n      }\n      return props.page - 1;\n    });\n    const nextPage = computed(() => {\n      if (props.page >= pages.value) {\n        return props.page;\n      }\n      return props.page + 1;\n    });\n    const paginate = selectPage => {\n      emit(\"update:page\", selectPage);\n    };\n    return {\n      pages,\n      prevPage,\n      nextPage,\n      paginate\n    };\n  }\n};","map":{"version":3,"names":["computed","props","setup","emit","pages","Math","ceil","count","perPage","prevPage","page","nextPage","value","paginate","selectPage"],"sources":["G:\\develop\\commands_project\\git_hub\\command_project\\frontend-vue3\\src\\components\\UserPagination.vue"],"sourcesContent":["<template>\r\n  <ul class=\"catalog__pagination pagination\">\r\n    <li class=\"pagination__item\">\r\n      <button\r\n        class=\"pagination__link pagination__link--arrow\"\r\n        :class=\"{ 'pagination__link--disabled': page === prevPage }\"\r\n        @click.prevent=\"paginate(prevPage)\"\r\n        aria-label=\"Предыдущая страница\"\r\n      >\r\n        <svg width=\"8\" height=\"14\" fill=\"black\">\r\n          <use xlink:href=\"#icon-arrow-left\" />\r\n        </svg>\r\n      </button>\r\n    </li>\r\n\r\n    <li class=\"pagination__item\" v-for=\"pageNumber in pages\" :key=\"pageNumber\">\r\n      <a\r\n        href=\"#\"\r\n        class=\"pagination__link\"\r\n        :class=\"{\r\n          'pagination__link--current': pageNumber === page,\r\n          'pagination__link--disabled': pageNumber === page,\r\n        }\"\r\n        @click.prevent=\"paginate(pageNumber)\"\r\n      >\r\n        {{ pageNumber }}\r\n      </a>\r\n    </li>\r\n\r\n    <li class=\"pagination__item\">\r\n      <button\r\n        class=\"pagination__link pagination__link--arrow\"\r\n        :class=\"{ 'pagination__link--disabled': page === nextPage }\"\r\n        @click.prevent=\"paginate(nextPage)\"\r\n        aria-label=\"Следующая страница\"\r\n      >\r\n        <svg width=\"8\" height=\"14\" fill=\"currentColor\">\r\n          <use xlink:href=\"#icon-arrow-right\" />\r\n        </svg>\r\n      </button>\r\n    </li>\r\n  </ul>\r\n</template>\r\n\r\n<script>\r\nimport { computed } from \"vue\";\r\n\r\nexport default {\r\n  props: [\"page\", \"count\", \"perPage\"],\r\n\r\n  setup(props, { emit }) {\r\n    const pages = computed(() => Math.ceil(props.count / props.perPage));\r\n    const prevPage = computed(() => {\r\n      if (props.page === 1) {\r\n        return props.page;\r\n      }\r\n      return props.page - 1;\r\n    });\r\n    const nextPage = computed(() => {\r\n      if (props.page >= pages.value) {\r\n        return props.page;\r\n      }\r\n      return props.page + 1;\r\n    });\r\n\r\n    const paginate = (selectPage) => {\r\n      emit(\"update:page\", selectPage);\r\n    };\r\n\r\n    return {\r\n      pages,\r\n      prevPage,\r\n      nextPage,\r\n      paginate,\r\n    };\r\n  },\r\n};\r\n</script>\r\n\r\n<style lang=\"stylus\">\r\n@import '@/assets/stylus/base/vars.styl';\r\n\r\n.catalog__pagination\r\n  margin-top 30px\r\n\r\n.pagination__link--arrow\r\n  border-radius border-small\r\n\r\n.pagination__link\r\n  padding: 10px 3px\r\n</style>\r\n"],"mappings":"AA6CA,SAASA,QAAO,QAAS,KAAK;AAE9B,eAAe;EACbC,KAAK,EAAE,CAAC,MAAM,EAAE,OAAO,EAAE,SAAS,CAAC;EAEnCC,KAAKA,CAACD,KAAK,EAAE;IAAEE;EAAK,CAAC,EAAE;IACrB,MAAMC,KAAI,GAAIJ,QAAQ,CAAC,MAAMK,IAAI,CAACC,IAAI,CAACL,KAAK,CAACM,KAAI,GAAIN,KAAK,CAACO,OAAO,CAAC,CAAC;IACpE,MAAMC,QAAO,GAAIT,QAAQ,CAAC,MAAM;MAC9B,IAAIC,KAAK,CAACS,IAAG,KAAM,CAAC,EAAE;QACpB,OAAOT,KAAK,CAACS,IAAI;MACnB;MACA,OAAOT,KAAK,CAACS,IAAG,GAAI,CAAC;IACvB,CAAC,CAAC;IACF,MAAMC,QAAO,GAAIX,QAAQ,CAAC,MAAM;MAC9B,I
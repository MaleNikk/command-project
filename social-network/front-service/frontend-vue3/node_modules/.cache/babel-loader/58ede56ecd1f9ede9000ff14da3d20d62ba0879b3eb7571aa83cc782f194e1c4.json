{"ast":null,"code":"import { computed, ref, watch } from \"vue\";\nimport useTranslations from \"@/composables/useTranslations\";\nexport default {\n  name: \"PasswordRepeatField\",\n  props: {\n    modelValue: {\n      type: String,\n      default: \"\"\n    },\n    v: {\n      type: Object,\n      required: true\n    },\n    id: {\n      type: String,\n      required: true\n    }\n  },\n  setup(props, {\n    emit\n  }) {\n    const passwordFieldType = ref(\"password\");\n    const passwordHelperShow = ref(true);\n    const {\n      translationsLang\n    } = useTranslations();\n    const password = computed({\n      get() {\n        return props.modelValue;\n      },\n      set(value) {\n        emit(\"input\", value);\n      }\n    });\n    const updateValue = Value => {\n      password.value = Value;\n      emit(\"update:modelValue\", Value);\n    };\n    const switchVisibility = () => {\n      passwordFieldType.value = passwordFieldType.value === \"password\" ? \"text\" : \"password\";\n    };\n    watch(password, newVal => {\n      emit(\"update:modelValue\", newVal);\n    });\n    return {\n      passwordFieldType,\n      passwordHelperShow,\n      translationsLang,\n      updateValue,\n      password,\n      switchVisibility\n    };\n  }\n};","map":{"version":3,"names":["computed","ref","watch","useTranslations","name","props","modelValue","type","String","default","v","Object","required","id","setup","emit","passwordFieldType","passwordHelperShow","translationsLang","password","get","set","value","updateValue","Value","switchVisibility","newVal"],"sources":["B:\\develop\\commands_project\\repository\\frontend-vue3\\src\\components\\FormElements\\PasswordRepeatFieldChange.vue"],"sourcesContent":["<template>\r\n  <div class=\"change-password__group\" :class=\"{ fill: password.length > 0 }\">\r\n    <input\r\n      class=\"change-password__input\"\r\n      name=\"password\"\r\n      :id=\"id\"\r\n      :type=\"passwordFieldType\"\r\n      :value=\"modelValue\"\r\n      @input=\"updateValue($event.target.value)\"\r\n      @change=\"v.$touch()\"\r\n      :class=\"{\r\n        invalid:\r\n          (v.$dirty && !v.required) ||\r\n          (v.$dirty && !v.minLength) ||\r\n          (v.$dirty && !v.sameAsPassword),\r\n      }\"\r\n      placeholder=\"Повторите пароль\"\r\n    />\r\n    <span class=\"change-password__error\" v-if=\"v.$dirty && !v.required\"\r\n      >Обязательно для заполнения</span\r\n    >\r\n\r\n    <span\r\n      class=\"change-password__error\"\r\n      v-if=\"v.$dirty && !v.sameAsPassword && v.required\"\r\n      >{{ translationsLang.matchPassword }}</span\r\n    >\r\n\r\n    <span\r\n      class=\"change-password__error\"\r\n      v-if=\"v.$dirty && !v.minLength && v.sameAsPassword\"\r\n    >\r\n      {{ translationsLang.validatePass1 }} {{ v.$params.minLength.min }}\r\n      {{ translationsLang.validatePass2 }}\r\n      {{ password.length }}\r\n    </span>\r\n\r\n    <div\r\n      class=\"change-password__password-icon\"\r\n      :class=\"{ active: password.length > 0 }\"\r\n      @click=\"switchVisibility\"\r\n    >\r\n      <img src=\"@/assets/static/img/password-eye.svg\" alt=\"img.svg\" />\r\n    </div>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport { computed, ref, watch } from \"vue\";\r\nimport useTranslations from \"@/composables/useTranslations\";\r\n\r\nexport default {\r\n  name: \"PasswordRepeatField\",\r\n  props: {\r\n    modelValue: {\r\n      type: String,\r\n      default: \"\",\r\n    },\r\n    v: {\r\n      type: Object,\r\n      required: true,\r\n    },\r\n    id: {\r\n      type: String,\r\n      required: true,\r\n    },\r\n  },\r\n\r\n  setup(props, { emit }) {\r\n    const passwordFieldType = ref(\"password\");\r\n    const passwordHelperShow = ref(true);\r\n    const { translationsLang } = useTranslations();\r\n\r\n    const password = computed({\r\n      get() {\r\n        return props.modelValue;\r\n      },\r\n      set(value) {\r\n        emit(\"input\", value);\r\n      },\r\n    });\r\n\r\n    const updateValue = (Value) => {\r\n      password.value = Value;\r\n      emit(\"update:modelValue\", Value);\r\n    };\r\n\r\n    const switchVisibility = () => {\r\n      passwordFieldType.value =\r\n        passwordFieldType.value === \"password\" ? \"text\" : \"password\";\r\n    };\r\n\r\n    watch(password, (newVal) => {\r\n      emit(\"update:modelValue\", newVal);\r\n    });\r\n\r\n    return {\r\n      passwordFieldType,\r\n      passwordHelperShow,\r\n      translationsLang,\r\n      updateValue,\r\n      password,\r\n      switchVisibility,\r\n    };\r\n  },\r\n};\r\n</script>\r\n"],"mappings":"AAgDA,SAASA,QAAQ,EAAEC,GAAG,EAAEC,KAAI,QAAS,KAAK;AAC1C,OAAOC,eAAc,MAAO,+BAA+B;AAE3D,eAAe;EACbC,IAAI,EAAE,qBAAqB;EAC3BC,KAAK,EAAE;IACLC,UAAU,EAAE;MACVC,IAAI,EAAEC,MAAM;MACZC,OAAO,EAAE;IACX,CAAC;IACDC,CAAC,EAAE;MACDH,IAAI,EAAEI,MAAM;MACZC,QAAQ,EAAE;IACZ,CAAC;IACDC,EAAE,EAAE;MACFN,IAAI,EAAEC,MAAM;MACZI,QAAQ,EAAE;IACZ;EACF,CAAC;EAEDE,KAAKA,CAACT,KAAK,EAAE;IAAEU;EAAK,CAAC,EAAE;IACrB,MAAMC,iBAAgB,GAAIf,GAAG,CAAC,UAAU,CAAC;IACzC,MAAMgB,kBAAiB,GAAIhB,GAAG,CAAC,IAAI,CAAC;IACpC,MAAM;MAAEiB;IAAiB,IAAIf,eAAe,CAAC,CAAC;IAE9C,MAAMgB,QAAO,GAAInB,QAAQ,CAAC;MACxBoB,GAAGA,CAAA,EAAG;QACJ,OAAOf,KAAK,CAACC,UAAU;MACzB,CAAC;MACDe,GAAGA,CAACC,KAAK,EAAE;QACTP,IAAI,CAAC,OAAO,EAAEO,KAAK,CAAC;MACtB;IACF,CAAC,CAAC;IAEF,MAAMC,WAAU,GAAKC,KAAK,IAAK;MAC7BL,QAAQ,CAACG,KAAI,GAAIE,KAAK;MACtBT,IAAI,CAAC,mBAAmB,EAAES,KAAK,CAAC;IAClC,CAAC;IAED,MAAMC,gBAAe,GAAIA,CAAA,KAAM;MAC7BT,iBAAiB,CAACM,KAAI,GACpBN,iBAAiB,CAACM,KAAI,KAAM,UAAS,GAAI,MAAK,GAAI,UAAU;IAChE,CAAC;IAEDpB,KAAK,CAACiB,QAAQ,EAAGO,MAAM,IAAK;MAC1BX,IAAI,CAAC,mBAAmB,EAAEW,MAAM,CAAC;IACnC,CAAC,CAAC;IAEF,OAAO;MACLV,iBAAiB;MACjBC,kBAAkB;MAClBC,gBAAgB;MAChBK,WAAW;MACXJ,QAAQ;MACRM;IACF,CAAC;EACH;AACF,CAAC"},"metadata":{},"sourceType":"module","externalDependencies":[]}
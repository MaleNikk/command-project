{"ast":null,"code":"import { computed } from \"vue\";\nimport { useStore } from \"vuex\";\nimport dayjs from \"dayjs\";\nexport default {\n  name: \"InfiniteLoadingItem\",\n  props: {\n    index: {\n      // index of current item\n      type: Number\n    },\n    source: {\n      type: Object,\n      default() {\n        return {};\n      }\n    }\n  },\n  setup(props) {\n    const {\n      getters,\n      state\n    } = useStore();\n    const info = computed(() => state.profile.info.info);\n    const messageConversation = computed(() => {\n      return props.source?.conversationPartner1 === info.value?.id ? props.source?.conversationPartner2 : props.source?.conversationPartner2 === info.value?.id ? props.source?.conversationPartner1 : null;\n    });\n    const isSentByMe = computed(() => {\n      return props.source?.conversationPartner1 === info.value?.id ? true : props.source?.conversationPartner2 === info.value?.id ? false : false;\n    });\n    const getInfo = () => {\n      return getters[\"profile/info/getInfo\"];\n    };\n    const formatTime = time => {\n      return dayjs(time).format(\"YYYY-MM-DD HH:mm\");\n    };\n    return {\n      messageConversation,\n      isSentByMe,\n      getInfo,\n      formatTime\n    };\n  }\n};","map":{"version":3,"names":["computed","useStore","dayjs","name","props","index","type","Number","source","Object","default","setup","getters","state","info","profile","messageConversation","conversationPartner1","value","id","conversationPartner2","isSentByMe","getInfo","formatTime","time","format"],"sources":["G:\\develop\\commands_project\\repository\\frontend-vue3\\src\\components\\Im\\ChatMessage.vue"],"sourcesContent":["<template>\r\n  <div>\r\n    <!--  Please avoid to use margin between -->\r\n    <!--  messages block or it will glitter on-->\r\n    <!--  scroll-->\r\n    <h5 class=\"im-chat__message-title\" v-if=\"source.stubDate\">\r\n      {{ source.date }}\r\n    </h5>\r\n\r\n    <div v-else class=\"im-chat__message-block\" :class=\"{ me: isSentByMe }\">\r\n      <p class=\"im-chat__message-text\">{{ source.messageText }}</p>\r\n      <span class=\"im-chat__message-time\">\r\n        {{ formatTime(source.time) }}\r\n      </span>\r\n    </div>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport { computed } from \"vue\";\r\nimport { useStore } from \"vuex\";\r\nimport dayjs from \"dayjs\";\r\n\r\nexport default {\r\n  name: \"InfiniteLoadingItem\",\r\n  props: {\r\n    index: {\r\n      // index of current item\r\n      type: Number,\r\n    },\r\n    source: {\r\n      type: Object,\r\n      default() {\r\n        return {};\r\n      },\r\n    },\r\n  },\r\n\r\n  setup(props) {\r\n    const { getters, state } = useStore();\r\n\r\n    const info = computed(() => state.profile.info.info);\r\n\r\n    const messageConversation = computed(() => {\r\n      return props.source?.conversationPartner1 === info.value?.id\r\n        ? props.source?.conversationPartner2\r\n        : props.source?.conversationPartner2 === info.value?.id\r\n        ? props.source?.conversationPartner1\r\n        : null;\r\n    });\r\n\r\n    const isSentByMe = computed(() => {\r\n      return props.source?.conversationPartner1 === info.value?.id\r\n        ? true\r\n        : props.source?.conversationPartner2 === info.value?.id\r\n        ? false\r\n        : false;\r\n    });\r\n\r\n    const getInfo = () => {\r\n      return getters[\"profile/info/getInfo\"];\r\n    };\r\n\r\n    const formatTime = (time) => {\r\n      return dayjs(time).format(\"YYYY-MM-DD HH:mm\");\r\n    };\r\n\r\n    return {\r\n      messageConversation,\r\n      isSentByMe,\r\n      getInfo,\r\n      formatTime,\r\n    };\r\n  },\r\n};\r\n</script>\r\n\r\n<style lang=\"stylus\" scoped>\r\n@import '@/assets/stylus/base/vars.styl';\r\n\r\n.im-chat__message-block:not(:last-child) {\r\n  margin-bottom 20px\r\n}\r\n.im-chat__message-day\r\n  &+&\r\n    margin-top 50px\r\n\r\n.im-chat__message-title\r\n  color #8A94A4\r\n  font-size font-size-downdefault\r\n  text-align center\r\n  display block\r\n  width 100%\r\n\r\n.im-chat__message-block\r\n  display flex\r\n  align-items center\r\n\r\n  &+&\r\n    margin-top 20px\r\n\r\n  &.me + &\r\n    margin-top 30px\r\n\r\n  &.me\r\n    flex-direction row-reverse\r\n    max-width 650px\r\n    margin-left auto\r\n\r\n    .im-chat__message-text\r\n      background-color ui-cl-color-eucalypt\r\n      color ui-cl-color-white-theme\r\n      box-shadow 0px 4px 15px #D4E8DD\r\n\r\n    .im-chat__message-time\r\n      margin-right 15px\r\n      margin-left 0\r\n\r\n.im-chat__message-text\r\n  word-wrap break-word\r\n  background-color ui-cl-color-white-theme\r\n  box-shadow 0px 4px 14px #e1e1e1\r\n  border-radius border-big-radius\r\n  padding 15px 20px\r\n  color ui-cl-color-steel-gray\r\n  font-size font-size-downdefault\r\n  line-height 23px\r\n  overflow-x hidden\r\n\r\n.im-chat__message-time\r\n  min-width 105px\r\n  font-size font-size-small\r\n  color #BAC3D0\r\n  margin-left 15px\r\n</style>\r\n"],"mappings":"AAmBA,SAASA,QAAO,QAAS,KAAK;AAC9B,SAASC,QAAO,QAAS,MAAM;AAC/B,OAAOC,KAAI,MAAO,OAAO;AAEzB,eAAe;EACbC,IAAI,EAAE,qBAAqB;EAC3BC,KAAK,EAAE;IACLC,KAAK,EAAE;MACL;MACAC,IAAI,EAAEC;IACR,CAAC;IACDC,MAAM,EAAE;MACNF,IAAI,EAAEG,MAAM;MACZC,OAAOA,CAAA,EAAG;QACR,OAAO,CAAC,CAAC;MACX;IACF;EACF,CAAC;EAEDC,KAAKA,CAACP,KAAK,EAAE;IACX,MAAM;MAAEQ,OAAO;MAAEC;IAAM,IAAIZ,QAAQ,CAAC,CAAC;IAErC,MAAMa,IAAG,GAAId,QAAQ,CAAC,MAAMa,KAAK,CAACE,OAAO,CAACD,IAAI,CAACA,IAAI,CAAC;IAEpD,MAAME,mBAAkB,GAAIhB,QAAQ,CAAC,MAAM;MACzC,OAAOI,KAAK,CAACI,MAAM,EAAES,oBAAmB,KAAMH,IAAI,CAACI,KAAK,EAAEC,EAAC,GACvDf,KAAK,CAACI,MAAM,EAAEY,oBAAmB,GACjChB,KAAK,CAACI,MAAM,EAAEY,oBAAmB,KAAMN,IAAI,CAACI,KAAK,EAAEC,EAAC,GACpDf,KAAK,CAACI,MAAM,EAAES,oBAAmB,GACjC,IAAI;IACV,CAAC,CAAC;IAEF,MAAMI,UAAS,GAAIrB,QAAQ,CAAC,MAAM;MAChC,OAAOI,KAAK,CAACI,MAAM,EAAES,oBAAmB,KAAMH,IAAI,CAACI,KAAK,EAAEC,EAAC,GACvD,IAAG,GACHf,KAAK,CAACI,MAAM,EAAEY,oBAAmB,KAAMN,IAAI,CAACI,KAAK,EAAEC,EAAC,GACpD,KAAI,GACJ,KAAK;IACX,CAAC,CAAC;IAEF,MAAMG,OAAM,GAAIA
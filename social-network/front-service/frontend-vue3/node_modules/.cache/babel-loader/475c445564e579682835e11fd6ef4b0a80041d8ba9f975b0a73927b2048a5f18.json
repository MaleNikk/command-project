{"ast":null,"code":"import { computed, onMounted, ref, watch } from \"vue\";\nimport { useStore } from \"vuex\";\nimport useTranslations from \"@/composables/useTranslations\";\nimport SearchBlock from \"@/components/Search/Block\";\nimport BlockSearch from \"@/components/Friends/BlockSearch.vue\";\nimport Pagination from \"@/components/UserPagination.vue\";\nexport default {\n  name: \"SearchUsers\",\n  components: {\n    SearchBlock,\n    BlockSearch,\n    Pagination\n  },\n  setup() {\n    const {\n      getters,\n      dispatch,\n      commit\n    } = useStore();\n    const page = ref(1);\n    const size = ref(5);\n    const total = ref(20);\n    const {\n      translationsLang\n    } = useTranslations();\n    const users = computed(() => getters[\"global/search/getResultByIdSearch\"](\"users\"));\n    const getUsersQueryParams = computed(() => getters[\"global/search/getUsersQueryParams\"]);\n    const getUsersPagination = computed(() => getters[\"global/search/getUsersPagination\"]);\n    watch(page, () => {\n      const searchQuery = {\n        ...getUsersQueryParams.value,\n        page: page.value - 1,\n        size: size.value\n      };\n      dispatch(\"global/search/searchUsers\", {\n        payload: searchQuery\n      });\n    });\n    watch(getUsersPagination, () => {\n      total.value = getUsersPagination.value.total;\n    });\n    onMounted(() => {\n      const searchQuery = {\n        ...getUsersQueryParams.value,\n        page: page.value - 1,\n        size: size.value\n      };\n      if (users.value.length === 0) {\n        dispatch(\"global/search/searchUsers\", {\n          payload: searchQuery\n        });\n      }\n    });\n    const setUsersPagination = () => {\n      commit(\"global/search/setUsersPagination\");\n    };\n    return {\n      page,\n      size,\n      total,\n      translationsLang,\n      users,\n      getUsersPagination,\n      setUsersPagination\n    };\n  }\n};","map":{"version":3,"names":["computed","onMounted","ref","watch","useStore","useTranslations","SearchBlock","BlockSearch","Pagination","name","components","setup","getters","dispatch","commit","page","size","total","translationsLang","users","getUsersQueryParams","getUsersPagination","searchQuery","value","payload","length","setUsersPagination"],"sources":["G:\\develop\\commands_project\\git_hub\\command_project\\frontend-vue3\\src\\components\\Search\\Users.vue"],"sourcesContent":["<template>\r\n  <div class=\"search-users\" v-if=\"users.length > 0\">\r\n    <search-block :title=\"translationsLang.searchUserTitle\" id=\"users\">\r\n      <div class=\"friends__list\">\r\n        <block-search\r\n          v-for=\"user in users\"\r\n          :key=\"user.id\"\r\n          :info=\"user\"\r\n          subscribe-button\r\n          :page=\"page\"\r\n          :size=\"size\"\r\n        />\r\n      </div>\r\n\r\n      <pagination\r\n        :count=\"getUsersPagination.totalElements\"\r\n        v-model:page=\"page\"\r\n        :per-page=\"size\"\r\n      />\r\n    </search-block>\r\n  </div>\r\n  <div class=\"search-news__nonews\" v-else>\r\n    {{ translationsLang.searchUserEmpty }}\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport { computed, onMounted, ref, watch } from \"vue\";\r\nimport { useStore } from \"vuex\";\r\nimport useTranslations from \"@/composables/useTranslations\";\r\nimport SearchBlock from \"@/components/Search/Block\";\r\nimport BlockSearch from \"@/components/Friends/BlockSearch.vue\";\r\nimport Pagination from \"@/components/UserPagination.vue\";\r\n\r\nexport default {\r\n  name: \"SearchUsers\",\r\n  components: { SearchBlock, BlockSearch, Pagination },\r\n\r\n  setup() {\r\n    const { getters, dispatch, commit } = useStore();\r\n    const page = ref(1);\r\n    const size = ref(5);\r\n    const total = ref(20);\r\n    const { translationsLang } = useTranslations();\r\n\r\n    const users = computed(() =>\r\n      getters[\"global/search/getResultByIdSearch\"](\"users\")\r\n    );\r\n    const getUsersQueryParams = computed(\r\n      () => getters[\"global/search/getUsersQueryParams\"]\r\n    );\r\n    const getUsersPagination = computed(\r\n      () => getters[\"global/search/getUsersPagination\"]\r\n    );\r\n\r\n    watch(page, () => {\r\n      const searchQuery = {\r\n        ...getUsersQueryParams.value,\r\n        page: page.value - 1,\r\n        size: size.value,\r\n      };\r\n      dispatch(\"global/search/searchUsers\", { payload: searchQuery });\r\n    });\r\n\r\n    watch(getUsersPagination, () => {\r\n      total.value = getUsersPagination.value.total;\r\n    });\r\n\r\n    onMounted(() => {\r\n      const searchQuery = {\r\n        ...getUsersQueryParams.value,\r\n        page: page.value - 1,\r\n        size: size.value,\r\n      };\r\n      if (users.value.length === 0) {\r\n        dispatch(\"global/search/searchUsers\", { payload: searchQuery });\r\n      }\r\n    });\r\n\r\n    const setUsersPagination = () => {\r\n      commit(\"global/search/setUsersPagination\");\r\n    };\r\n\r\n    return {\r\n      page,\r\n      size,\r\n      total,\r\n      translationsLang,\r\n      users,\r\n      getUsersPagination,\r\n      setUsersPagination,\r\n    };\r\n  },\r\n};\r\n</script>\r\n"],"mappings":"AA2BA,SAASA,QAAQ,EAAEC,SAAS,EAAEC,GAAG,EAAEC,KAAI,QAAS,KAAK;AACrD,SAASC,QAAO,QAAS,MAAM;AAC/B,OAAOC,eAAc,MAAO,+BAA+B;AAC3D,OAAOC,WAAU,MAAO,2BAA2B;AACnD,OAAOC,WAAU,MAAO,sCAAsC;AAC9D,OAAOC,UAAS,MAAO,iCAAiC;AAExD,eAAe;EACbC,IAAI,EAAE,aAAa;EACnBC,UAAU,EAAE;IAAEJ,WAAW;IAAEC,WAAW;IAAEC;EAAW,CAAC;EAEpDG,KAAKA,CAAA,EAAG;IACN,MAAM;MAAEC,OAAO;MAAEC,QAAQ;MAAEC;IAAO,IAAIV,QAAQ,CAAC,CAAC;IAChD,MAAMW,IAAG,GAAIb,GAAG,CAAC,CAAC,CAAC;IACnB,MAAMc,IAAG,GAAId,GAAG,CAAC,CAAC,CAAC;IACnB,MAAMe,KAAI,GAAIf,GAAG,CAAC,EAAE,CAAC;IACrB,MAAM;MAAEgB;IAAiB,IAAIb,eAAe,CAAC,CAAC;IAE9C,MAAMc,KAAI,GAAInB,QAAQ,CAAC,MACrBY,OAAO,CAAC,mCAAmC,CAAC,CAAC,OAAO,CACtD,CAAC;IACD,MAAMQ,mBAAkB,GAAIpB,QAAQ,CAClC,MAAMY,OAAO,CAAC,mCAAmC,CACnD,CAAC;IACD,MAAMS,kBAAiB,GAAIrB,QAAQ,CACjC,MAAMY,OAAO,CAAC,kCAAkC,
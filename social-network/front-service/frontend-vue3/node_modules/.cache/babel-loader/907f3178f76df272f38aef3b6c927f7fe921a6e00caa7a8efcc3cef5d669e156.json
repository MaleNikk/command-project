position absolute\r\n  height 3px\r\n  width 100%\r\n  background-color ui-cl-color-eucalypt\r\n  opacity 1\r\n  left 0\r\n  transform rotate(0deg)\r\n  transition transform 0.25s ease-in-out, opacity 0.25s ease-in-out\r\n\r\n.burger-menu__button span:nth-child(1)\r\n  top 0px\r\n\r\n.burger-menu__button span:nth-child(2)\r\n  top 8px\r\n\r\n.burger-menu__button span:nth-child(3)\r\n  top 16px\r\n\r\n.burger-menu__button.active span:nth-child(1),\r\n.burger-menu__button.active span:nth-child(4)\r\n  transform rotate(45deg)\r\n  top: 16px;\r\n\r\n.burger-menu__button.active span:nth-child(2)\r\n  opacity 0\r\n  transform rotate(45deg)\r\n\r\n.burger-menu__button.active span:nth-child(3)\r\n  transform rotate(-45deg)\r\n</style>\r\n"],"mappings":";;EAMSA,KAAK,EAAC;AAAkB;;EACtBA,KAAK,EAAC;AAAkB;;EAsBpBA,KAAK,EAAC;AAAoB;;;EAGLA,KAAK,EAAC;;;;;;;;;wCA/BxCC,mBAAA,CAsCM;IArCJD,KAAK,EAAAE,eAAA,EAAC,sBAAsB;MAAAC,MAAA,EACVC,MAAA,CAAAC,QAAQ;MAAAC,KAAA,EAASF,MAAA,CAAAG;IAAW;MAG9CC,mBAAA,CAgCM,OAhCNC,UAgCM,GA/BJD,mBAAA,CA8BM,OA9BNE,UA8BM,I,kBA7BJT,mBAAA,CA4BcU,SAAA,QAAAC,WAAA,CAzBYR,MAAA,CAAAS,IAAI,GAApBC,IAAI,EAAEC,KAAK;yBAHrBC,YAAA,CA4BcC,sBAAA;MA3BXC,KAAK,EAAEd,MAAA,CAAAe,YAAY,iBAAiBL,IAAI,CAACM,OAAO,GAAGN,IAAI,CAACM,OAAO;MAChEpB,KAAK,EAAAE,eAAA,EAAC,mBAAmB;iCAKuCY,IAAI,CAACO,IAAI,CAACC,IAAI,aAAalB,MAAA,CAAAmB,gBAAgB,EAAEC,KAAK,QAAyBV,IAAI,CAACO,IAAI,CAACC,IAAI,kBAAkBlB,MAAA,CAAAqB,aAAa,EAAED,KAAK;aAAqBpB,MAAA,CAAAmB,gBAAgB,EAAEC,KAAK;;MAH1OE,GAAG,EAAEX,KAAK;MACVY,KAAK,EAAEb,IAAI,CAACa,KAAK;MACjBC,EAAE,EAAEd,IAAI,CAACO,IAAI;MAOb,WAAS,EAAgBP,IAAI,CAACO,IAAI,CAACC,IAAI,YAA2BlB,MAAA,CAAAmB,gBAAgB,EAAEC,KAAK,GAAkBV,IAAI,CAACO,IAAI,CAACC,IAAI,iBAAgClB,MAAA,CAAAqB,aAAa,EAAED,KAAK,G;;wBAQ9K,MAEM,CAFNhB,mBAAA,CAEM,OAFNqB,UAEM,GADJC,YAAA,CAAmCC,wBAAA;QAAnBT,IAAI,EAAER,IAAI,CAACkB;gCAEhB5B,MAAA,CAAAG,WAAW,I,cAAxBN,mBAAA,CAES,QAFTgC,UAES,EAAAC,gBAAA,CADP9B,MAAA,CAAAe,YAAY,iBAAiBL,IAAI,CAACqB,IAAI,GAAGrB,IAAI,CAACM,OAAO,U,cAEvDnB,mBAAA,CAAmC,QAAAmC,UAAA,EAAAF,gBAAA,CAAnBpB,IAAI,CAACqB,IAA
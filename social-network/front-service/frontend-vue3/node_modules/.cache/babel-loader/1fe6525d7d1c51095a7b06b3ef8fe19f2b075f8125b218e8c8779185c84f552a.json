{"ast":null,"code":"import { computed, onMounted, onUnmounted, ref } from \"vue\";\nimport { useStore } from \"vuex\";\nimport { useRoute } from \"vue-router\";\nimport scroll from \"@/directives/scroll\";\nimport SidebarIcons from \"@/Icons/sidebar/SidebarIcons.vue\";\nexport default {\n  name: \"MainLayoutSidebar\",\n  directives: {\n    scroll\n  },\n  components: {\n    SidebarIcons\n  },\n  setup() {\n    const store = useStore();\n    const route = useRoute();\n    const {\n      getters,\n      state\n    } = store;\n    const isOpen = ref(false);\n    const isSticky = ref(false);\n    const scrollPosition = ref(0);\n    const unreadedMessages = computed(() => getters[\"profile/dialogs/unreadedMessages\"]);\n    const requestsCount = computed(() => state.profile.friends.requestsCount);\n    const isAdminPage = computed(() => route.path.indexOf(\"admin\") !== -1);\n    const info = computed(() => getters[\"global/menu/getSidebarById\"](isAdminPage.value ? \"admin\" : \"user\"));\n    const translations = computed(() => state.auth.languages.language.name);\n    const removeBodyOverflow = computed(() => {\n      const body = document.querySelector(\"body\");\n      return {\n        computedStyle: () => {\n          if (isOpen.value) {\n            body.style.overflow = \"hidden\";\n          } else {\n            body.style.overflow = \"\";\n          }\n        }\n      };\n    });\n    const bodyOverflow = computed(() => {\n      return removeBodyOverflow.value.computedStyle();\n    });\n    onMounted(() => {\n      store.dispatch(\"profile/friends/apiRequestsCount\");\n      store.dispatch(\"profile/dialogs/apiUnreadedMessages\");\n      scrollPosition.value = window.scrollY;\n    });\n    onUnmounted(() => {\n      window.removeEventListener(\"scroll\", handleScroll);\n    });\n    const handleScroll = () => {\n      isSticky.value = window.scrollY > 85;\n    };\n    return {\n      isSticky,\n      unreadedMessages,\n      requestsCount,\n      isAdminPage,\n      info,\n      translations,\n      removeBodyOverflow,\n      bodyOverflow,\n      handleScroll\n    };\n  }\n};","map":{"version":3,"names":["computed","onMounted","onUnmounted","ref","useStore","useRoute","scroll","SidebarIcons","name","directives","components","setup","store","route","getters","state","isOpen","isSticky","scrollPosition","unreadedMessages","requestsCount","profile","friends","isAdminPage","path","indexOf","info","value","translations","auth","languages","language","removeBodyOverflow","body","document","querySelector","computedStyle","style","overflow","bodyOverflow","dispatch","window","scrollY","removeEventListener","handleScroll"],"sources":["B:\\develop\\commands_project\\repository\\frontend-vue3\\src\\components\\MainLayout\\Sidebar.vue"],"sourcesContent":["<template>\r\n  <div\r\n    class=\"main-layout__sidebar\"\r\n    :class=\"{ sticky: isSticky, admin: isAdminPage }\"\r\n    v-scroll=\"handleScroll\"\r\n  >\r\n    <div class=\"wrapper__sidebar\">\r\n      <nav class=\"main-layout__nav\">\r\n        <router-link\r\n          :title=\"translations === 'Русский' ? item.textEng : item.textEng\"\r\n          class=\"main-layout__link\"\r\n          v-for=\"(item, index) in info\"\r\n          :key=\"index\"\r\n          :exact=\"item.exact\"\r\n          :to=\"item.link\"\r\n          :class=\"{\r\n            'main-layout__link--im':\r\n              (item.link.name === 'Im' && unreadedMessages?.count > 0) ||\r\n              (item.link.name === 'Friends' && requestsCount?.count),\r\n            big: unreadedMessages?.count >= 100,\r\n          }\"\r\n          :data-push=\"\r\n            item.link.name === 'Im'\r\n              ? unreadedMessages?.count\r\n              : item.link.name === 'Friends'\r\n              ? requestsCount?.count\r\n              : false\r\n          \"\r\n        >\r\n          <div class=\"simple-svg-wrapper\">\r\n            <sidebar-icons :name=\"item.icon\" />\r\n          </div>\r\n          <span v-if=\"!isAdminPage\" class=\"sidebar__text\">{{\r\n            translations === \"Русский\" ? item.text : item.textEng\r\n          }}</span>\r\n          <span v-else>{{ item.text }}</span>\r\n        </router-link>\r\n      </nav>\r\n    </div>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport { computed, onMounted, onUnmounted, ref } from \"vue\";\r\nimport { useStore } from \"vuex\";\r\nimport { useRoute } from \"vue-router\";\r\nimport scroll from \"@/directives/scroll\";\r\nimport SidebarIcons from \"@/Icons/sidebar/SidebarIcons.vue\";\r\n\r\nexport default {\r\n  name: \"MainLayoutSidebar\",\r\n  directives: {\r\n    scroll,\r\n  },\r\n  components: { SidebarIcons },\r\n\r\n  setup() {\r\n    const store = useStore();\r\n    const route = useRoute();\r\n    const { getters, state } = store;\r\n    const isOpen = ref(false);\r\n    const isSticky = ref(false);\r\n    const scrollPosition = ref(0);\r\n\r\n    const unreadedMessages = computed(\r\n      () => getters[\"profile/dialogs/unreadedMessages\"]\r\n    );\r\n    const requestsCount = computed(() => state.profile.friends.requestsCount);\r\n\r\n    const isAdminPage = computed(() => route.path.indexOf(\"admin\") !== -1);\r\n    const info = computed(() =>\r\n      getters[\"global/menu/getSidebarById\"](\r\n        isAdminPage.value ? \"admin\" : \"user\"\r\n      )\r\n    );\r\n    const translations = computed(() => state.auth.languages.language.name);\r\n    const removeBodyOverflow = computed(() => {\r\n      const body = document.querySelector(\"body\");\r\n      return {\r\n        computedStyle: () => {\r\n          if (isOpen.value) {\r\n            body.style.overflow = \"hidden\";\r\n          } else {\r\n            body.style.overflow = \"\";\r\n          }\r\n        },\r\n      };\r\n    });\r\n    const bodyOverflow = computed(() => {\r\n      return removeBodyOverflow.value.computedStyle();\r\n    });\r\n\r\n    onMounted(() => {\r\n      store.dispatch(\"profile/friends/apiRequestsCount\");\r\n      store.dispatch(\"profile/dialogs/apiUnreadedMessages\");\r\n      scrollPosition.value = window.scrollY;\r\n    });\r\n\r\n    onUnmounted(() => {\r\n      window.removeEventListener(\"scroll\", handleScroll);\r\n    });\r\n\r\n    const handleScroll = () => {\r\n      isSticky.value = window.scrollY > 85;\r\n    };\r\n\r\n    return {\r\n      isSticky,\r\n      unreadedMessages,\r\n      requestsCount,\r\n      isAdminPage,\r\n      info,\r\n      translations,\r\n      removeBodyOverflow,\r\n      bodyOverflow,\r\n      handleScroll,\r\n    };\r\n  },\r\n};\r\n</script>\r\n\r\n<style lang=\"stylus\">\r\n@import '@/assets/stylus/base/vars.styl';\r\n\r\n.form-layout__main\r\n  margin auto 0\r\n\r\n.wrapper__sidebar\r\n  width 1280px\r\n  padding 0 15px\r\n  margin 0 auto\r\n\r\n.main-layout__nav\r\n  display flex\r\n  gap 30px\r\n\r\n.main-layout__logotype\r\n  display inline-flex\r\n  align-items center\r\n  user-select none\r\n  pointer-events none\r\n  gap 10px\r\n  width 100%\r\n  max-width unset\r\n  p\r\n    font-size 25px\r\n    font-weight font-weight-medium\r\n    text-transform uppercase\r\n  svg path:nth-child(3)\r\n    animation gradient 1s linear infinite\r\n\r\n@keyframes gradient {\r\n  0% {\r\n    opacity: 0;\r\n  }\r\n  50% {\r\n    opacity: 1;\r\n  }\r\n  100% {\r\n    opacity: 0;\r\n  }\r\n}\r\n\r\n.main-layout__sidebar\r\n  position absolute\r\n  top 85px\r\n  left 0\r\n  color ui-cl-color-white-theme\r\n  display flex\r\n  width 100%\r\n  padding 20px 0\r\n  background ui-cl-color-white-theme\r\n  border-bottom 1px solid #cbcbcb\r\n  z-index 7\r\n  transition none\r\n\r\n  &.admin\r\n    background ui-cl-color-gun-powder\r\n    padding 0\r\n    top 0\r\n    .main-layout__link\r\n      padding 20px 10px\r\n      color ui-cl-color-white-theme\r\n      transition all .2s ease-in-out\r\n      @media (any-hover: hover)\r\n        &:hover\r\n          background #ffffff14\r\n\r\n  &.sticky\r\n    position fixed\r\n    top 0\r\n    transition none\r\n\r\n.main-layout__logo\r\n  margin-bottom 100px\r\n  display flex\r\n  align-items center\r\n\r\n  &.admin\r\n    max-width 100%\r\n\r\n.main-layout__admin-logo\r\n  width 100%\r\n  margin-left 10px\r\n\r\n.main-layout__link\r\n  color #6f6f6f\r\n  display flex\r\n  gap 5px\r\n  align-items center\r\n  transition color .2s ease-in-out\r\n  position relative\r\n\r\n  &:hover\r\n    color #000\r\n\r\n\r\n  &--im\r\n    &:after\r\n      content attr(data-push)\r\n      font-weight font-weight-regular\r\n      font-size font-size-super-small\r\n      width 15px\r\n      height 15px\r\n      color ui-cl-color-white-theme\r\n      background-color #E65151\r\n      border-radius border-half\r\n      display flex\r\n      align-items center\r\n      justify-content center\r\n      position absolute\r\n      right -13px\r\n      top 10%\r\n      transform translateY(-50%)\r\n\r\n    &.big\r\n      &:after\r\n        width 35px\r\n        height 35px\r\n        right 5px\r\n\r\n  &.router-link-active\r\n    color ui-cl-color-eucalypt\r\n\r\n  .simple-svg-wrapper\r\n    width 16px\r\n    height 16px\r\n    flex none\r\n\r\n    & svg\r\n      vertical-align text-top\r\n      height 100%\r\n\r\n\r\n.burger-menu__button\r\n  position relative\r\n  display inline-block\r\n  width 30px\r\n  background transparent\r\n  height 20px\r\n  position relative\r\n  cursor pointer\r\n  z-index 150\r\n\r\n.burger-menu__button span\r\n  display block\r\n  position absolute\r\n  height 3px\r\n  width 100%\r\n  background-color ui-cl-color-eucalypt\r\n  opacity 1\r\n  left 0\r\n  transform rotate(0deg)\r\n  transition transform 0.25s ease-in-out, opacity 0.25s ease-in-out\r\n\r\n.burger-menu__button span:nth-child(1)\r\n  top 0px\r\n\r\n.burger-menu__button span:nth-child(2)\r\n  top 8px\r\n\r\n.burger-menu__button span:nth-child(3)\r\n  top 16px\r\n\r\n.burger-menu__button.active span:nth-child(1),\r\n.burger-menu__button.active span:nth-child(4)\r\n  transform rotate(45deg)\r\n  top: 16px;\r\n\r\n.burger-menu__button.active span:nth-child(2)\r\n  opacity 0\r\n  transform rotate(45deg)\r\n\r\n.burger-menu__button.active span:nth-child(3)\r\n  transform rotate(-45deg)\r\n</style>\r\n"],"mappings":"AA2CA,SAASA,QAAQ,EAAEC,SAAS,EAAEC,WAAW,EAAEC,GAAE,QAAS,KAAK;AAC3D,SAASC,QAAO,QAAS,MAAM;AAC/B,SAASC,QAAO,QAAS,YAAY;AACrC,OAAOC,MAAK,MAAO,qBAAqB;AACxC,OAAOC,YAAW,MAAO,kCAAkC;AAE3D,eAAe;EACbC,IAAI,EAAE,mBAAmB;EACzBC,UAAU,EAAE;IACVH;EACF,CAAC;EACDI,UAAU,EAAE;IAAEH;EAAa,CAAC;EAE5BI,KAAKA,CAAA,EAAG;IACN,MAAMC,KAAI,GAAIR,QAAQ,CAAC,CAAC;IACxB,MAAMS,KAAI,GAAIR,QAAQ,CAAC,CAAC;IACxB,MAAM;MAAES,OAAO;MAAEC;IAAM,IAAIH,KAAK;IAChC,MAAMI,MAAK,GAAIb,GAAG,CAAC,KAAK,CAAC;IACzB,MAAMc,QAAO,GAAId,GAAG,CAAC,KAAK,CAAC;IAC3B,MAAMe,cAAa,GAAIf,GAAG,CAAC,CAAC,CAAC;IAE7B,MAAMgB,gBAAe,GAAInB,QAAQ,CAC/B,MAAMc,OAAO,CAAC,kCAAkC,CAClD,CAAC;IACD,MAAMM,aAAY,GAAIpB,QAAQ,CAAC,MAAMe,KAAK,CAACM,OAAO,CAACC,OAAO,CAACF,aAAa,CAAC;IAEzE,MAAMG,WAAU,GAAIvB,QAAQ,CAAC,MAAMa,KAAK,CAACW,IAAI,CAACC,OAAO,CAAC,OAAO,MAAM,CAAC,CAAC,CAAC;IACtE,MAAMC,IAAG,GAAI1B,QAAQ,CAAC,MACpBc,OAAO,CAAC,4BAA4B,CAAC,CACnCS,WAAW,CAACI,KAAI,GAAI,OAAM,GAAI,MAChC,CACF,CAAC;IACD,MAAMC,YAAW,GAAI5B,QAAQ,CAAC,MAAMe,KAAK,CAACc,IAAI,CAACC,SAAS,CAACC,QAAQ,CAACvB,IAAI,CAAC;IACvE,MAAMwB,kBAAiB,GAAIhC,QAAQ,CAAC,MAAM;MACxC,MAAMiC,IAAG,GAAIC,QAAQ,CAACC,aAAa,CAAC,MAAM,CAAC;MAC3C,OAAO;QACLC,aAAa,EAAEA,CAAA,KAAM;UACnB,IAAIpB,MAAM,CAACW,KAAK,EAAE;YAChBM,IAAI,CAACI,KAAK,CAACC,QAAO,GAAI,QAAQ;UAChC,OAAO;YACLL,IAAI,CAACI,KAAK,CAACC,QAAO,GAAI,EAAE;UAC1B;QACF;MACF,CAAC;IACH,CAAC,CAAC;IACF,MAAMC,YAAW,GAAIvC,QAAQ,CAAC,MAAM;MAClC,OAAOgC,kBAAkB,CAACL,KAAK,CAACS,aAAa,CAAC,CAAC;IACjD,CAAC,CAAC;IAEFnC,SAAS,CAAC,MAAM;MACdW,KAAK,CAAC4B,QAAQ,CAAC,kCAAkC,CAAC;MAClD5B,KAAK,CAAC4B,QAAQ,CAAC,qCAAqC,CAAC;MACrDtB,cAAc,CAACS,KAAI,GAAIc,MAAM,CAACC,OAAO;IACvC,CAAC,CAAC;IAEFxC,WAAW,CAAC,MAAM;MAChBuC,MAAM,CAACE,mBAAmB,CAAC,QAAQ,EAAEC,YAAY,CAAC;IACpD,CAAC,CAAC;IAEF,MAAMA,YAAW,GAAIA,CAAA,KAAM;MACzB3B,QAAQ,CAACU,KAAI,GAAIc,MAAM,CAACC,OAAM,GAAI,EAAE;IACtC,CAAC;IAED,OAA
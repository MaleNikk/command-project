{"ast":null,"code":"import { ref, onMounted } from 'vue';\nimport Inputmask from 'inputmask';\nimport pattern from '@/directives/pattern';\nexport default {\n  name: 'UserInfoFormBlock',\n  directives: {\n    pattern: pattern.directives\n  },\n  props: {\n    label: String,\n    placeholder: String,\n    modelValue: String,\n    phone: Boolean,\n    about: Boolean,\n    text: String,\n    required: Boolean\n  },\n  setup(props, {\n    emit\n  }) {\n    const phoneRef = ref(null);\n    onMounted(() => {\n      if (props.phone) {\n        var im = new Inputmask('+7 (999) 999-99-99');\n        im.mask(phoneRef.value);\n      }\n    });\n    const updateValue = event => {\n      emit('update:modelValue', event.target.value);\n    };\n    const validate = () => {\n      if (!props.modelValue) {\n        return false;\n      }\n      return true;\n    };\n    return {\n      phoneRef,\n      updateValue,\n      validate\n    };\n  }\n};","map":{"version":3,"names":["ref","onMounted","Inputmask","pattern","name","directives","props","label","String","placeholder","modelValue","phone","Boolean","about","text","required","setup","emit","phoneRef","im","mask","value","updateValue","event","target","validate"],"sources":["B:\\develop\\commands_project\\repository\\frontend-vue3\\src\\components\\Settings\\UserInfoForm\\Block.vue"],"sourcesContent":["<template>\r\n  <div class=\"settings-main-input\">\r\n    <span class=\"user-info-form__label_stylus\">{{ label }}</span>\r\n\r\n    <div class=\"user-info-form__wrap\">\r\n      <textarea\r\n        class=\"user-info-form__input_stylus user-info-form__input_stylus--textarea\"\r\n        :value=\"modelValue\"\r\n        @input=\"updateValue\"\r\n        v-if=\"about\"\r\n        maxlength=\"200\"\r\n      ></textarea>\r\n\r\n      <input\r\n        class=\"user-info-form__input_stylus\"\r\n        type=\"text\"\r\n        v-pattern=\"20\"\r\n        :value=\"modelValue\"\r\n        :placeholder=\"placeholder\"\r\n        :required=\"required\"\r\n        @input=\"updateValue\"\r\n        v-if=\"text\"\r\n      />\r\n\r\n      <input\r\n        class=\"user-info-form__input_stylus\"\r\n        type=\"text\"\r\n        :value=\"modelValue\"\r\n        :placeholder=\"placeholder\"\r\n        @input=\"updateValue\"\r\n        :ref=\"phone ? 'phoneRef' : undefined\"\r\n        v-if=\"phone\"\r\n      />\r\n    </div>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport { ref, onMounted } from 'vue';\r\nimport Inputmask from 'inputmask';\r\nimport pattern from '@/directives/pattern';\r\n\r\nexport default {\r\n  name: 'UserInfoFormBlock',\r\n\r\n  directives: {\r\n    pattern: pattern.directives,\r\n  },\r\n\r\n  props: {\r\n    label: String,\r\n    placeholder: String,\r\n    modelValue: String,\r\n    phone: Boolean,\r\n    about: Boolean,\r\n    text: String,\r\n    required: Boolean,\r\n  },\r\n\r\n  setup(props, { emit }) {\r\n    const phoneRef = ref(null);\r\n\r\n    onMounted(() => {\r\n    if (props.phone) {\r\n      var im = new Inputmask('+7 (999) 999-99-99');\r\n      im.mask(phoneRef.value);\r\n    }\r\n    });\r\n\r\n    const updateValue = (event) => {\r\n      emit('update:modelValue', event.target.value)\r\n    };\r\n\r\n    const validate = () => {\r\n      if(!props.modelValue) {\r\n        return false;\r\n      }\r\n      return true;\r\n    }\r\n\r\n    return {\r\n      phoneRef,\r\n      updateValue,\r\n      validate,\r\n    };\r\n  },\r\n};\r\n</script>\r\n\r\n<style lang=\"stylus\">\r\n.settings-main-input\r\n  &:not(:last-child)\r\n    margin-bottom 15px\r\n</style>\r\n"],"mappings":"AAsCA,SAASA,GAAG,EAAEC,SAAQ,QAAS,KAAK;AACpC,OAAOC,SAAQ,MAAO,WAAW;AACjC,OAAOC,OAAM,MAAO,sBAAsB;AAE1C,eAAe;EACbC,IAAI,EAAE,mBAAmB;EAEzBC,UAAU,EAAE;IACVF,OAAO,EAAEA,OAAO,CAACE;EACnB,CAAC;EAEDC,KAAK,EAAE;IACLC,KAAK,EAAEC,MAAM;IACbC,WAAW,EAAED,MAAM;IACnBE,UAAU,EAAEF,MAAM;IAClBG,KAAK,EAAEC,OAAO;IACdC,KAAK,EAAED,OAAO;IACdE,IAAI,EAAEN,MAAM;IACZO,QAAQ,EAAEH;EACZ,CAAC;EAEDI,KAAKA,CAACV,KAAK,EAAE;IAA
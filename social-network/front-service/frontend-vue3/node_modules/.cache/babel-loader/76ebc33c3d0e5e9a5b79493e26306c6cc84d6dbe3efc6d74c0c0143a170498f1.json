{"ast":null,"code":"import { onMounted, ref } from \"vue\";\nimport { useRoute } from \"vue-router\";\nimport axios from \"axios\";\nexport default {\n  name: \"ShiftEmailSuccess\",\n  setup() {\n    const route = useRoute();\n    const temp = ref(\"\");\n    onMounted(() => {\n      temp.value = route.query.temp || \"\";\n    });\n    const submitHandler = () => {\n      axios({\n        url: \"/auth/confirm-email \",\n        data: {\n          temp: temp.value\n        },\n        method: \"PUT\"\n      }).then(() => {\n        alert(\"Почта удачно подтвеждена!\");\n      }).catch(error => {\n        alert(\"Произошла ошибка при подтверждении почты. Пожалуйста, попробуйте снова.\");\n        console.error(\"Error confirming email:\", error);\n      });\n    };\n    return {\n      temp,\n      submitHandler\n    };\n  }\n};","map":{"version":3,"names":["onMounted","ref","useRoute","axios","name","setup","route","temp","value","query","submitHandler","url","data","method","then","alert","catch","error","console"],"sources":["G:\\develop\\commands_project\\repository\\frontend-vue3\\src\\pages\\Shift\\ShiftEmailConfirm.vue"],"sourcesContent":["<template>\r\n  <div class=\"shift-password\">\r\n    <form class=\"shift-password__form\" @submit.prevent=\"submitHandler\">\r\n      <div class=\"success-shift-emaill\">\r\n        <img src=\"@/assets/static/img/success-forgot.svg\" alt=\"img.svg\" />\r\n      </div>\r\n\r\n      <div class=\"form__block\">\r\n        <h4 class=\"form__subtitle\">\r\n          Для подтверждения новой почты нажимайте на кнопку.\r\n        </h4>\r\n      </div>\r\n\r\n      <div class=\"shift-btn__action\">\r\n        <button-hover tag=\"button\" type=\"submit\" variant=\"white\"\r\n          >Подтвердить</button-hover\r\n        >\r\n      </div>\r\n    </form>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport { onMounted, ref } from \"vue\";\r\nimport { useRoute } from \"vue-router\";\r\nimport axios from \"axios\";\r\n\r\nexport default {\r\n  name: \"ShiftEmailSuccess\",\r\n\r\n  setup() {\r\n    const route = useRoute();\r\n    const temp = ref(\"\");\r\n\r\n    onMounted(() => {\r\n      temp.value = route.query.temp || \"\";\r\n    });\r\n\r\n    const submitHandler = () => {\r\n      axios({\r\n        url: \"/auth/confirm-email \",\r\n        data: { temp: temp.value },\r\n        method: \"PUT\",\r\n      })\r\n        .then(() => {\r\n          alert(\"Почта удачно подтвеждена!\");\r\n        })\r\n        .catch((error) => {\r\n          alert(\r\n            \"Произошла ошибка при подтверждении почты. Пожалуйста, попробуйте снова.\"\r\n          );\r\n          console.error(\"Error confirming email:\", error);\r\n        });\r\n    };\r\n\r\n    return {\r\n      temp,\r\n      submitHandler,\r\n    };\r\n  },\r\n};\r\n</script>\r\n\r\n<style lang=\"stylus\">\r\n.shift-password\r\n  display flex\r\n  justify-content center\r\n  flex-direction column\r\n  height 70%\r\n\r\n.shift-btn__action\r\n  margin-top 40px\r\n  display flex\r\n  justify-content center\r\n  align-items center\r\n\r\n.success-shift-email\r\n  height 100%\r\n  display flex\r\n  justify-content center\r\n  align-items center\r\n\r\n  .simple-svg-wrapper\r\n    width 120px\r\n</style>\r\n"],"mappings":"AAuBA,SAASA,SAAS,EAAEC,GAAE,QAAS,KAAK;AACpC,SAASC,QAAO,QAAS,YAAY;AACrC,OAAOC,KAAI,MAAO,OAAO;AAEzB,eAAe;EACbC,IAAI,EAAE,mBAAmB;EAEzBC,KAAKA,CAAA,EAAG;IACN,MAAMC,KAAI,GAAIJ,QAAQ,CAAC,CAAC;IACxB,MAAMK,IAAG,GAAIN,GAAG,CAAC,EAAE,CAAC;IAEpBD,SAAS,CAAC,MAAM;MACdO,IAAI,CAACC,KAAI,GAAIF,KAAK,CAACG,KAAK,CAACF,IAAG,IAAK,EAAE;IACrC,CAAC,CAAC;IAEF,MAAMG,aAAY,GAAIA,CAAA,KAAM;MAC1BP,KAAK,CAAC;QACJQ,GAAG,EAAE,sBAAsB;QAC3BC,IAAI,EAAE;UAAEL,IAAI,EAAEA,IAAI,CAACC;QAAM,CAAC;QAC1BK,MAAM,EAAE;MACV,CAAC,EACEC,IAAI,CAAC,MAAM;QACVC,KAAK,CAAC,2BAA2B,CAAC;MACpC,CAAC,EACAC,KAAK,CAAEC,KAAK,IAAK;QAChBF,KAAK,CACH,yEACF,CAAC;QACDG,OAAO,CAACD,KAAK,CAAC,yBAAyB,EAAEA,KAAK,CAAC;MACjD,CAAC,CAAC;IACN,CAAC;IAED,OAAO;MACLV,IAAI;MACJG;IACF,CAAC;EACH;AACF,CAAC"},
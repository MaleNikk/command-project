{"ast":null,"code":"import { computed, onMounted, ref } from \"vue\";\nimport { useStore } from \"vuex\";\nimport { useRoute } from \"vue-router\";\nimport PostTimer from \"@/Icons/PostTimer.vue\";\nimport ShowMore from \"@/Icons/ShowMore.vue\";\nimport UnknowUser from \"@/Icons/UnknowUser.vue\";\nimport AddForm from \"@/components/News/AddForm\";\nimport LikeComment from \"@/components/LikeComment\";\nimport Comments from \"@/components/Comments/Index.vue\";\nimport vClickOutside from \"click-outside-vue3\";\nimport useTranslations from \"@/composables/useTranslations\";\nimport PostReactions from \"@/components/PostReactions.vue\";\nimport dayjs from \"dayjs\";\nexport default {\n  name: \"NewsBlock\",\n  directives: {\n    clickOutside: vClickOutside.directive\n  },\n  components: {\n    Comments,\n    LikeComment,\n    AddForm,\n    PostTimer,\n    ShowMore,\n    UnknowUser,\n    PostReactions\n  },\n  props: {\n    info: {\n      type: Object,\n      default: () => ({\n        title: \"Дизайн привычных вещей\",\n        post_text: \"А вот и «Книга недели от Skillbox и МИФ».\" + \" Сегодня делимся с вами книгой «Дизайн привычных вещей» автора Дональда Нормана.\" + \" В ней Дональд рассказывает об основополагающих принципах, которым нужно следовать\" + \" чтобы избежать проблем и превратить привычные вещи в приятные товары, доставляющие\" + \" нам удовольствие А вот и «Книга недели от Skillbox и МИФ». Сегодня делимся с вами\" + \" книгой «Дизайн привычных вещей» автора Дональда Нормана. В ней Дональд рассказывает\" + \" об основополагающих принципах, которым нужно следовать, чтобы избежать проблем и\" + \" превратить привычные вещи в приятные товары, доставляющие нам удовольствие\",\n        time: 1559751301818,\n        likes: 44,\n        id: 1,\n        tags: [],\n        comments: {},\n        author: \"\"\n      })\n    },\n    edit: Boolean,\n    deffered: Boolean,\n    admin: Boolean,\n    blocked: Boolean,\n    deleted: Boolean,\n    queued: {\n      type: Boolean,\n      default: false\n    }\n  },\n  setup(props) {\n    const {\n      getters,\n      state,\n      dispatch\n    } = useStore();\n    const route = useRoute();\n    const openCommnets = ref(false);\n    const isLotText = ref(false);\n    const openText = ref(false);\n    const isEditNews = ref(false);\n    const commnets = ref(\"\");\n    const showInfoTimer = ref(false);\n    const showActions = ref(false);\n    const textRef = ref(null);\n    const {\n      translationsLang\n    } = useTranslations();\n    const getInfo = computed(() => getters[\"profile/info/getInfo\"]);\n    const comments = computed(() => state.profile.comments.comments);\n    const currentComments = computed(() => comments.value[props.info.id]);\n    const displayedText = computed(() => {\n      const words = props.info.postText.split(\" \");\n      if (words.length > 100 && !openText.value) {\n        return words.slice(0, 100).join(\" \") + \"...\";\n      }\n      return props.info.postText;\n    });\n    const currentPostText = computed(() => {\n      const words = props.info.postText.split(\" \").length;\n      return words;\n    });\n    const timeToRead = computed(() => {\n      const wordsCount = props.info.postText.split(\" \").length;\n      const averageReadingSpeed = 150;\n      const timeInMinutes = Math.ceil(wordsCount / averageReadingSpeed);\n      return timeInMinutes;\n    });\n    onMounted(() => {\n      isLotText.value = textRef.value.offsetHeight > 150;\n    });\n    const toggleText = () => {\n      openText.value = !openText.value;\n    };\n    const actionsShow = () => {\n      showActions.value = !showActions.value;\n    };\n    const closeActions = () => {\n      showActions.value = false;\n    };\n    const toggleComments = async () => {\n      const isSetComments = !!currentComments.value;\n      const currentPage = isSetComments ? currentComments.value.page : null;\n      if (!isSetComments) {\n        try {\n          await dispatch(\"profile/comments/commentsById\", {\n            postId: props.info.id,\n            currentPage\n          });\n          openCommnets.value = !openCommnets.value;\n        } catch (error) {\n          console.log(error);\n        }\n      } else {\n        openCommnets.value = !openCommnets.value;\n      }\n    };\n    const showMore = async () => {\n      await dispatch(\"profile/comments/commentsById\", {\n        postId: props.info.id,\n        currentPage: currentComments.value.page\n      });\n    };\n    const deleteReaction = () => {\n      dispatch(\"global/likes/deleteLike\", {\n        itemId: props.info.id,\n        data: {\n          type: \"DELETE\",\n          reactionType: null\n        }\n      });\n    };\n    const newlikeAction = reactionType => {\n      dispatch(\"global/likes/putLike\", {\n        itemId: props.info.id,\n        data: {\n          type: \"POST\",\n          reactionType: reactionType\n        }\n      });\n    };\n    const likeAction = active => {\n      if (active) dispatch(\"global/likes/deleteLike\", {\n        itemId: props.info.id,\n        type: \"DELETE\"\n      });else dispatch(\"global/likes/putLike\", {\n        itemId: props.info.id,\n        data: {\n          type: \"POST\",\n          reactionType: null\n        }\n      });\n    };\n    const toggleEditNews = () => {\n      isEditNews.value = !isEditNews.value;\n    };\n    const routerLink = infoAuthorId => {\n      return getInfo.value?.id === infoAuthorId ? {\n        name: \"Profile\"\n      } : {\n        name: \"ProfileId\",\n        params: {\n          id: infoAuthorId\n        }\n      };\n    };\n    const deleteNews = () => {\n      dispatch(\"profile/feeds/deleteFeeds\", {\n        id: getInfo.value.id,\n        postId: props.info.id,\n        route: route.name\n      });\n    };\n    const formatTime = time => {\n      return dayjs(time).fromNow();\n    };\n    const formatTimeChange = timeChange => {\n      return dayjs(timeChange).fromNow();\n    };\n    const formatTimeLLLL = time => {\n      return dayjs(time).fromNow(\"LLLL\");\n    };\n    const formatPublisheLLLL = publishe => {\n      return dayjs(publishe).fromNow(\"LLLL\");\n    };\n    const formatTimeFrom = time => {\n      return dayjs(time).fromNow(\"from\");\n    };\n    const formatTimeChangeFrom = timeChange => {\n      return dayjs(timeChange).fromNow(\"from\");\n    };\n\n    // const deletePost = () => {\n    //   dispatch('users/info/deletePost');\n    // };\n\n    return {\n      openCommnets,\n      openText,\n      isEditNews,\n      commnets,\n      showInfoTimer,\n      showActions,\n      textRef,\n      translationsLang,\n      comments,\n      currentComments,\n      displayedText,\n      currentPostText,\n      timeToRead,\n      toggleText,\n      actionsShow,\n      closeActions,\n      toggleComments,\n      showMore,\n      deleteReaction,\n      newlikeAction,\n      likeAction,\n      toggleEditNews,\n      routerLink,\n      deleteNews,\n      formatTime,\n      formatTimeChange,\n      formatTimeLLLL,\n      formatPublisheLLLL,\n      formatTimeFrom,\n      formatTimeChangeFrom\n    };\n  }\n};","map":{"version":3,"names":["computed","onMounted","ref","useStore","useRoute","PostTimer","ShowMore","UnknowUser","AddForm","LikeComment","Comments","vClickOutside","useTranslations","PostReactions","dayjs","name","directives","clickOutside","directive","components","props","info","type","Object","default","title","post_text","time","likes","id","tags","comments","author","edit","Boolean","deffered","admin","blocked","deleted","queued","setup","getters","state","dispatch","route","openCommnets","isLotText","openText","isEditNews","commnets","showInfoTimer","showActions","textRef","translationsLang","getInfo","profile","currentComments","value","displayedText","words","postText","split","length","slice","join","currentPostText","timeToRead","wordsCount","averageReadingSpeed","timeInMinutes","Math","ceil","offsetHeight","toggleText","actionsShow","closeActions","toggleComments","isSetComments","currentPage","page","postId","error","console","log","showMore","deleteReaction","itemId","data","reactionType","newlikeAction","likeAction","active","toggleEditNews","routerLink","infoAuthorId","params","deleteNews","formatTime","fromNow","formatTimeChange","timeChange","formatTimeLLLL","formatPublisheLLLL","publishe","formatTimeFrom","formatTimeChangeFrom"],"sources":["G:\\develop\\commands_project\\repository\\frontend-vue3\\src\\components\\News\\Block.vue"],"sourcesContent":["<template>\r\n  <div>\r\n    <div v-if=\"queued\" class=\"news-block queued-news__block\">\r\n      <add-form\r\n        v-if=\"isEditNews\"\r\n        :info=\"info\"\r\n        edit=\"edit\"\r\n        :deffered=\"deffered\"\r\n        @submit-complete=\"toggleEditNews\"\r\n        @close-form=\"toggleEditNews\"\r\n      />\r\n      <template v-else>\r\n        <div class=\"post-block__top\">\r\n          <div class=\"post-block__top-author\">\r\n            <div class=\"post-block__top-avatar\">\r\n              <img\r\n                v-if=\"info.author.photo\"\r\n                :src=\"info.author.photo\"\r\n                :alt=\"info.author.firstName[0] + ' ' + info.author.lastName[0]\"\r\n              />\r\n              <div v-else>\r\n                <unknow-user />\r\n              </div>\r\n            </div>\r\n            <div class=\"post-block__info\">\r\n              <router-link :to=\"routerLink(info.author.id)\">\r\n                {{ info.author.firstName + \" \" + info.author.lastName }}\r\n              </router-link>\r\n              <span v-if=\"!info.timeChanged\">\r\n                {{ translationsLang.newsBlockPublishedTitle }}\r\n                {{ formatTime(info.time) }}\r\n              </span>\r\n              <span v-if=\"info.timeChanged\">\r\n                {{ translationsLang.newsBlockEditedTime }}\r\n                {{ formatTimeChange(info.timeChanged) }}\r\n              </span>\r\n            </div>\r\n          </div>\r\n          <div\r\n            v-if=\"(!admin && edit) || deleted\"\r\n            class=\"post-block__top-actions\"\r\n          >\r\n            <div class=\"button-top__actions\" @click=\"actionsShow\">\r\n              <show-more />\r\n            </div>\r\n            <transition name=\"fade\">\r\n              <div\r\n                v-if=\"showActions\"\r\n                class=\"post-block__showmore-actions\"\r\n                v-click-outside=\"closeActions\"\r\n              >\r\n                <button\r\n                  class=\"post-block__btn-edit\"\r\n                  v-if=\"edit\"\r\n                  @click=\"toggleEditNews\"\r\n                >\r\n                  {{ translationsLang.friendsBlockEdit }}\r\n                </button>\r\n                <button\r\n                  class=\"post-block__btn-edit\"\r\n                  v-if=\"deleted\"\r\n                  @click=\"deleteNews\"\r\n                >\r\n                  {{ translationsLang.newsBlockDeleted }}\r\n                </button>\r\n                <button class=\"post-block__btn-edit\" v-if=\"blocked\">\r\n                  {{ translationsLang.profileAccountUnblocking }}\r\n                </button>\r\n                <button class=\"post-block__btn-edit\" v-if=\"blocked\">\r\n                  {{ translationsLang.profileAccountBlocking }}\r\n                </button>\r\n              </div>\r\n            </transition>\r\n          </div>\r\n        </div>\r\n        <div class=\"news-block__deffered\" v-if=\"queued\">\r\n          <span class=\"news-block__deffered-text\">\r\n            {{ translationsLang.newsBlockQueuedTime }}\r\n            {{ formatTimeLLLL(info.time) }}\r\n            ({{ translationsLang.newsBlockQueuedDatatime }}\r\n            {{ formatPublisheLLLL(info.publishDate) }}\r\n            )\r\n          </span>\r\n        </div>\r\n        <div class=\"post-block__text\">\r\n          <div v-if=\"info.imagePath\">\r\n            <img class=\"post-image\" :src=\"info.imagePath\" :alt=\"'photo'\" />\r\n          </div>\r\n          <h3 class=\"post-block__title\">{{ info.title }}</h3>\r\n          <p\r\n            class=\"post-block__text-content\"\r\n            ref=\"textRef\"\r\n            v-html=\"displayedText\"\r\n          />\r\n          <div\r\n            v-if=\"currentPostText > 65 && !openText\"\r\n            @click.prevent=\"toggleText\"\r\n          >\r\n            <button class=\"post-block__showmore\">\r\n              {{ translationsLang.newsBlockReadedMore }}\r\n            </button>\r\n          </div>\r\n          <div v-if=\"openText\" @click.prevent=\"toggleText\">\r\n            <button class=\"post-block__showmore\">\r\n              {{ translationsLang.newsBlockReadedHide }}\r\n            </button>\r\n          </div>\r\n        </div>\r\n      </template>\r\n    </div>\r\n    <div\r\n      v-if=\"!queued\"\r\n      class=\"news-block\"\r\n      :class=\"{\r\n        deffered,\r\n        'news-block--admin': admin,\r\n        'news-block--edited': isEditNews,\r\n      }\"\r\n    >\r\n      <add-form\r\n        v-if=\"isEditNews\"\r\n        :info=\"info\"\r\n        edit=\"edit\"\r\n        :deffered=\"deffered\"\r\n        @submit-complete=\"toggleEditNews\"\r\n        @close-form=\"toggleEditNews\"\r\n      />\r\n      <template v-else>\r\n        <div class=\"post-block__top\">\r\n          <div class=\"post-block__top-author\">\r\n            <div class=\"post-block__top-avatar\">\r\n              <img\r\n                v-if=\"info.author.photo\"\r\n                :src=\"info.author.photo\"\r\n                :alt=\"info.author.firstName[0] + ' ' + info.author.lastName[0]\"\r\n              />\r\n              <div v-else>\r\n                <unknow-user />\r\n              </div>\r\n            </div>\r\n            <div class=\"post-block__info\">\r\n              <router-link :to=\"routerLink(info.author.id)\">{{\r\n                info.author.firstName + \" \" + info.author.lastName\r\n              }}</router-link>\r\n              <span v-if=\"!info.timeChanged\">\r\n                {{ translationsLang.newsBlockPublishedTitle }}\r\n                {{ formatTimeFrom(info.time) }}\r\n              </span>\r\n              <span v-if=\"info.timeChanged\">\r\n                {{ translationsLang.newsBlockEditedTime }}\r\n                {{ formatTimeChangeFrom(info.timeChanged) }}\r\n              </span>\r\n            </div>\r\n          </div>\r\n          <div\r\n            v-if=\"(!admin && edit) || deleted\"\r\n            class=\"post-block__top-actions\"\r\n          >\r\n            <div class=\"button-top__actions\" @click=\"actionsShow\">\r\n              <show-more />\r\n            </div>\r\n            <transition name=\"fade\">\r\n              <div\r\n                v-if=\"showActions\"\r\n                class=\"post-block__showmore-actions\"\r\n                v-click-outside=\"closeActions\"\r\n              >\r\n                <button\r\n                  class=\"post-block__btn-edit\"\r\n                  v-if=\"edit\"\r\n                  @click=\"toggleEditNews\"\r\n                >\r\n                  {{ translationsLang.friendsBlockEdit }}\r\n                </button>\r\n                <button\r\n                  class=\"post-block__btn-edit\"\r\n                  v-if=\"deleted\"\r\n                  @click=\"deleteNews\"\r\n                >\r\n                  {{ translationsLang.newsBlockDeleted }}\r\n                </button>\r\n                <button class=\"post-block__btn-edit\" v-if=\"blocked\">\r\n                  {{ translationsLang.profileAccountUnblocking }}\r\n                </button>\r\n                <button class=\"post-block__btn-edit\" v-if=\"blocked\">\r\n                  {{ translationsLang.profileAccountBlocking }}\r\n                </button>\r\n              </div>\r\n            </transition>\r\n          </div>\r\n        </div>\r\n        <h3 class=\"post-block__title\">{{ info.title }}</h3>\r\n        <div class=\"post-block__timer\">\r\n          <post-timer />\r\n          <span\r\n            @mouseover=\"showInfoTimer = true\"\r\n            @mouseout=\"showInfoTimer = false\"\r\n          >\r\n            {{ timeToRead }}\r\n            {{ translationsLang.newsBlockReadedTime }}\r\n          </span>\r\n          <transition name=\"fade\">\r\n            <div v-if=\"showInfoTimer\" class=\"post-block__timer-more\">\r\n              {{ translationsLang.newsBlockReadedDisclamer }}\r\n            </div>\r\n          </transition>\r\n        </div>\r\n        <ul class=\"post-block__tags\" v-if=\"info.tags && info.tags.length > 0\">\r\n          <li\r\n            class=\"post-block__tags-item\"\r\n            v-for=\"(tag, index) in info.tags\"\r\n            :key=\"index\"\r\n          >\r\n            <router-link\r\n              :to=\"{ name: 'Search', query: { tab: 'news', tags: tag.name } }\"\r\n            >\r\n              {{ \"#\" + tag.name }}\r\n            </router-link>\r\n          </li>\r\n        </ul>\r\n\r\n        <div class=\"post-block__text\">\r\n          <div v-if=\"info.imagePath\">\r\n            <img class=\"post-image\" :src=\"info.imagePath\" :alt=\"'photo'\" />\r\n          </div>\r\n          <p\r\n            class=\"post-block__text-content\"\r\n            ref=\"textRef\"\r\n            v-html=\"displayedText\"\r\n          />\r\n          <div\r\n            v-if=\"currentPostText > 65 && !openText\"\r\n            @click.prevent=\"toggleText\"\r\n          >\r\n            <button class=\"post-block__showmore\">\r\n              {{ translationsLang.newsBlockReadedMore }}\r\n            </button>\r\n          </div>\r\n          <div v-if=\"openText\" @click.prevent=\"toggleText\">\r\n            <button class=\"post-block__showmore\">\r\n              {{ translationsLang.newsBlockReadedHide }}\r\n            </button>\r\n          </div>\r\n        </div>\r\n\r\n        <div\r\n          class=\"post-block__actions\"\r\n          v-if=\"!queued && !admin\"\r\n          :class=\"{ 'open-comment': openCommnets }\"\r\n        >\r\n          <div\r\n            class=\"news-block__actions-block news-block__comments-btn\"\r\n            @click=\"toggleComments()\"\r\n            :title=\"\r\n              !openCommnets\r\n                ? translationsLang.newsBlockCommentTitleFirst\r\n                : translationsLang.newsBlockCommentTitleSecond\r\n            \"\r\n          >\r\n            <like-comment\r\n              :quantity=\"info.commentsCount\"\r\n              width=\"16px\"\r\n              height=\"16px\"\r\n              font-size=\"15px\"\r\n              color=\"ui-cl-color-eucalypt\"\r\n              comment=\"comment\"\r\n            />\r\n          </div>\r\n          <post-reactions\r\n            @reaction-deleted=\"deleteReaction\"\r\n            @reaction-added=\"newlikeAction\"\r\n            :active=\"info.myLike\"\r\n            :reaction=\"info.myReaction\"\r\n            :quantity=\"info.likeAmount\"\r\n            :reactions-info=\"info.reactionType\"\r\n          />\r\n\r\n          <!-- <div class=\"news-block__actions-block\">\r\n            <like-comment\r\n              :quantity=\"info.likeAmount\"\r\n              width=\"16px\"\r\n              height=\"16px\"\r\n              font-size=\"15px\"\r\n              @liked=\"likeAction\"\r\n              :active=\"info.myLike\"\r\n              :id=\"info.id\"\r\n            />\r\n          </div> -->\r\n        </div>\r\n        <transition name=\"fade\">\r\n          <div class=\"post-block__comments\" v-if=\"!queued && openCommnets\">\r\n            <comments\r\n              :admin=\"admin\"\r\n              :info=\"currentComments\"\r\n              :id=\"info.id\"\r\n              :edit=\"edit\"\r\n              :deleted=\"deleted\"\r\n            />\r\n            <button\r\n              v-if=\"\r\n                currentComments &&\r\n                currentComments.totalPages !== 0 &&\r\n                currentComments.page + 1 !== currentComments.totalPages\r\n              \"\r\n              class=\"post-block__comment-more\"\r\n              @click.prevent=\"showMore()\"\r\n            >\r\n              {{ translationsLang.newsBlockCommentMore }}\r\n            </button>\r\n          </div>\r\n        </transition>\r\n      </template>\r\n    </div>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport { computed, onMounted, ref } from \"vue\";\r\nimport { useStore } from \"vuex\";\r\nimport { useRoute } from \"vue-router\";\r\nimport PostTimer from \"@/Icons/PostTimer.vue\";\r\nimport ShowMore from \"@/Icons/ShowMore.vue\";\r\nimport UnknowUser from \"@/Icons/UnknowUser.vue\";\r\nimport AddForm from \"@/components/News/AddForm\";\r\nimport LikeComment from \"@/components/LikeComment\";\r\nimport Comments from \"@/components/Comments/Index.vue\";\r\nimport vClickOutside from \"click-outside-vue3\";\r\nimport useTranslations from \"@/composables/useTranslations\";\r\nimport PostReactions from \"@/components/PostReactions.vue\";\r\nimport dayjs from \"dayjs\";\r\n\r\nexport default {\r\n  name: \"NewsBlock\",\r\n  directives: {\r\n    clickOutside: vClickOutside.directive,\r\n  },\r\n  components: {\r\n    Comments,\r\n    LikeComment,\r\n    AddForm,\r\n    PostTimer,\r\n    ShowMore,\r\n    UnknowUser,\r\n    PostReactions,\r\n  },\r\n  props: {\r\n    info: {\r\n      type: Object,\r\n      default: () => ({\r\n        title: \"Дизайн привычных вещей\",\r\n        post_text:\r\n          \"А вот и «Книга недели от Skillbox и МИФ».\" +\r\n          \" Сегодня делимся с вами книгой «Дизайн привычных вещей» автора Дональда Нормана.\" +\r\n          \" В ней Дональд рассказывает об основополагающих принципах, которым нужно следовать\" +\r\n          \" чтобы избежать проблем и превратить привычные вещи в приятные товары, доставляющие\" +\r\n          \" нам удовольствие А вот и «Книга недели от Skillbox и МИФ». Сегодня делимся с вами\" +\r\n          \" книгой «Дизайн привычных вещей» автора Дональда Нормана. В ней Дональд рассказывает\" +\r\n          \" об основополагающих принципах, которым нужно следовать, чтобы избежать проблем и\" +\r\n          \" превратить привычные вещи в приятные товары, доставляющие нам удовольствие\",\r\n        time: 1559751301818,\r\n        likes: 44,\r\n        id: 1,\r\n        tags: [],\r\n        comments: {},\r\n        author: \"\",\r\n      }),\r\n    },\r\n    edit: Boolean,\r\n    deffered: Boolean,\r\n    admin: Boolean,\r\n    blocked: Boolean,\r\n    deleted: Boolean,\r\n    queued: {\r\n      type: Boolean,\r\n      default: false,\r\n    },\r\n  },\r\n\r\n  setup(props) {\r\n    const { getters, state, dispatch } = useStore();\r\n    const route = useRoute();\r\n    const openCommnets = ref(false);\r\n    const isLotText = ref(false);\r\n    const openText = ref(false);\r\n    const isEditNews = ref(false);\r\n    const commnets = ref(\"\");\r\n    const showInfoTimer = ref(false);\r\n    const showActions = ref(false);\r\n    const textRef = ref(null);\r\n    const { translationsLang } = useTranslations();\r\n\r\n    const getInfo = computed(() => getters[\"profile/info/getInfo\"]);\r\n    const comments = computed(() => state.profile.comments.comments);\r\n\r\n    const currentComments = computed(() => comments.value[props.info.id]);\r\n\r\n    const displayedText = computed(() => {\r\n      const words = props.info.postText.split(\" \");\r\n      if (words.length > 100 && !openText.value) {\r\n        return words.slice(0, 100).join(\" \") + \"...\";\r\n      }\r\n      return props.info.postText;\r\n    });\r\n    const currentPostText = computed(() => {\r\n      const words = props.info.postText.split(\" \").length;\r\n      return words;\r\n    });\r\n    const timeToRead = computed(() => {\r\n      const wordsCount = props.info.postText.split(\" \").length;\r\n      const averageReadingSpeed = 150;\r\n      const timeInMinutes = Math.ceil(wordsCount / averageReadingSpeed);\r\n      return timeInMinutes;\r\n    });\r\n\r\n    onMounted(() => {\r\n      isLotText.value = textRef.value.offsetHeight > 150;\r\n    });\r\n\r\n    const toggleText = () => {\r\n      openText.value = !openText.value;\r\n    };\r\n\r\n    const actionsShow = () => {\r\n      showActions.value = !showActions.value;\r\n    };\r\n\r\n    const closeActions = () => {\r\n      showActions.value = false;\r\n    };\r\n\r\n    const toggleComments = async () => {\r\n      const isSetComments = !!currentComments.value;\r\n      const currentPage = isSetComments ? currentComments.value.page : null;\r\n      if (!isSetComments) {\r\n        try {\r\n          await dispatch(\"profile/comments/commentsById\", {\r\n            postId: props.info.id,\r\n            currentPage,\r\n          });\r\n          openCommnets.value = !openCommnets.value;\r\n        } catch (error) {\r\n          console.log(error);\r\n        }\r\n      } else {\r\n        openCommnets.value = !openCommnets.value;\r\n      }\r\n\r\n    };\r\n\r\n    const showMore = async () => {\r\n      await dispatch(\"profile/comments/commentsById\", {\r\n        postId: props.info.id,\r\n        currentPage: currentComments.value.page,\r\n      });\r\n    };\r\n\r\n    const deleteReaction = () => {\r\n      dispatch(\"global/likes/deleteLike\", {\r\n        itemId: props.info.id,\r\n        data: { type: \"DELETE\", reactionType: null },\r\n      });\r\n    };\r\n\r\n    const newlikeAction = (reactionType) => {\r\n      dispatch(\"global/likes/putLike\", {\r\n        itemId: props.info.id,\r\n        data: { type: \"POST\", reactionType: reactionType },\r\n      });\r\n    };\r\n\r\n    const likeAction = (active) => {\r\n      if (active)\r\n        dispatch(\"global/likes/deleteLike\", {\r\n          itemId: props.info.id,\r\n          type: \"DELETE\",\r\n        });\r\n      else\r\n        dispatch(\"global/likes/putLike\", {\r\n          itemId: props.info.id,\r\n          data: { type: \"POST\", reactionType: null },\r\n        });\r\n    };\r\n\r\n    const toggleEditNews = () => {\r\n      isEditNews.value = !isEditNews.value;\r\n    };\r\n\r\n    const routerLink = (infoAuthorId) => {\r\n      return getInfo.value?.id === infoAuthorId\r\n        ? { name: \"Profile\" }\r\n        : { name: \"ProfileId\", params: { id: infoAuthorId } };\r\n    };\r\n\r\n    const deleteNews = () => {\r\n      dispatch(\"profile/feeds/deleteFeeds\", {\r\n        id: getInfo.value.id,\r\n        postId: props.info.id,\r\n        route: route.name,\r\n      });\r\n    };\r\n\r\n    const formatTime = (time) => {\r\n      return dayjs(time).fromNow();\r\n    };\r\n    const formatTimeChange = (timeChange) => {\r\n      return dayjs(timeChange).fromNow();\r\n    };\r\n    const formatTimeLLLL = (time) => {\r\n      return dayjs(time).fromNow(\"LLLL\");\r\n    };\r\n    const formatPublisheLLLL = (publishe) => {\r\n      return dayjs(publishe).fromNow(\"LLLL\");\r\n    };\r\n    const formatTimeFrom = (time) => {\r\n      return dayjs(time).fromNow(\"from\");\r\n    };\r\n    const formatTimeChangeFrom = (timeChange) => {\r\n      return dayjs(timeChange).fromNow(\"from\");\r\n    };\r\n\r\n    // const deletePost = () => {\r\n    //   dispatch('users/info/deletePost');\r\n    // };\r\n\r\n    return {\r\n      openCommnets,\r\n      openText,\r\n      isEditNews,\r\n      commnets,\r\n      showInfoTimer,\r\n      showActions,\r\n      textRef,\r\n      translationsLang,\r\n      comments,\r\n      currentComments,\r\n      displayedText,\r\n      currentPostText,\r\n      timeToRead,\r\n      toggleText,\r\n      actionsShow,\r\n      closeActions,\r\n      toggleComments,\r\n      showMore,\r\n      deleteReaction,\r\n      newlikeAction,\r\n      likeAction,\r\n      toggleEditNews,\r\n      routerLink,\r\n      deleteNews,\r\n      formatTime,\r\n      formatTimeChange,\r\n      formatTimeLLLL,\r\n      formatPublisheLLLL,\r\n      formatTimeFrom,\r\n      formatTimeChangeFrom,\r\n    };\r\n  },\r\n};\r\n</script>\r\n\r\n<style lang=\"stylus\">\r\n@import '@/assets/stylus/base/vars.styl';\r\n\r\n.open-comment\r\n  padding-bottom 30px\r\n  border-bottom 1px solid #BDCDD6\r\n.button-top__actions\r\n  cursor pointer\r\n  svg\r\n    pointer-events none\r\n\r\n.post-block__comment-more\r\n  background-color transparent\r\n  margin-top 20px\r\n  font-size font-size-downdefault\r\n  font-weight font-weight-medium\r\n  color ui-cl-color-eucalypt\r\n\r\n.post-block\r\n  max-width 910px\r\n  padding 30px\r\n  background-color ui-cl-color-white-theme\r\n  border-radius border-small\r\n  box-shadow box-shadow-main\r\n  &__comments\r\n    &.fade-enter-active,\r\n    &.fade-leave-active\r\n      transition all .2s ease-in-out\r\n    &.fade-enter,\r\n    &.fade-leave-to\r\n      opacity 0\r\n  &__top\r\n    position relative\r\n    display flex\r\n    align-items center\r\n    justify-content space-between\r\n    margin-bottom 25px\r\n    &-author\r\n      display flex\r\n      align-items center\r\n    &-avatar\r\n      display flex\r\n      align-items center\r\n      justify-content center\r\n      background #BDCDD6\r\n      width 40px\r\n      height 40px\r\n      border-radius border-half\r\n      overflow hidden\r\n      margin-right 15px\r\n      margin-right 10px\r\n      user-select none\r\n      pointer-events none\r\n      img\r\n        display flex\r\n        align-items center\r\n        justify-content center\r\n        width 100%\r\n        height 100%\r\n        object-fit cover\r\n    &-actions\r\n      display flex\r\n      gap 10px\r\n  &__showmore-actions\r\n    position absolute\r\n    display flex\r\n    flex-direction column\r\n    top 40px\r\n    right 0\r\n    background-color ui-cl-color-white-theme\r\n    border-radius border-small\r\n    padding 10px 0\r\n    min-width 150px\r\n    max-width 250px\r\n    box-shadow 0px 15px 40px rgba(0,0,0,10%)\r\n    z-index 12\
{"ast":null,"code":"import { watch, ref } from \"vue\";\nimport useTranslations from \"@/composables/useTranslations\";\nexport default {\n  name: \"PasswordRepeatField\",\n  props: {\n    modelValue: {\n      type: String,\n      default: \"\"\n    },\n    v: {\n      type: Object,\n      required: true\n    },\n    id: {\n      type: String,\n      required: true\n    }\n  },\n  setup(props, {\n    emit\n  }) {\n    const password = ref(props.modelValue);\n    const {\n      translationsLang\n    } = useTranslations();\n    watch(password, newVal => {\n      emit(\"update:modelValue\", newVal);\n    });\n    return {\n      translationsLang,\n      password\n    };\n  }\n};","map":{"version":3,"names":["watch","ref","useTranslations","name","props","modelValue","type","String","default","v","Object","required","id","setup","emit","password","translationsLang","newVal"],"sources":["G:\\develop\\commands_project\\git_hub\\command_project\\frontend-vue3\\src\\components\\FormElements\\PasswordRepeatField.vue"],"sourcesContent":["<template>\r\n  <div class=\"form__group\" :class=\"{ fill: password.length > 0 }\">\r\n    <label :for=\"id\" class=\"form__label_stylus\">{{\r\n      translationsLang.repeatPassword\r\n    }}</label>\r\n\r\n    <input\r\n      type=\"password\"\r\n      class=\"form__input_stylus\"\r\n      :id=\"id\"\r\n      v-model.trim=\"password\"\r\n      name=\"password\"\r\n      :class=\"{\r\n        invalid:\r\n          (v.$dirty && !v.required) ||\r\n          (v.$dirty && !v.minLength) ||\r\n          (v.$dirty && !v.sameAsPassword),\r\n      }\"\r\n      @change=\"v.$touch()\"\r\n    />\r\n\r\n    <span class=\"form__error\" v-if=\"v.$dirty && !v.sameAsPassword\">{{\r\n      translationsLang.matchPassword\r\n    }}</span>\r\n\r\n    <span class=\"form__error\" v-if=\"v.$dirty && !v.minLength\">\r\n      {{ translationsLang.validatePass1 }} {{ v.$params.minLength.min }}\r\n      {{ translationsLang.validatePass2 }}\r\n      {{ password.length }}\r\n    </span>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport { watch, ref } from \"vue\";\r\nimport useTranslations from \"@/composables/useTranslations\";\r\n\r\nexport default {\r\n  name: \"PasswordRepeatField\",\r\n  props: {\r\n    modelValue: {\r\n      type: String,\r\n      default: \"\",\r\n    },\r\n    v: {\r\n      type: Object,\r\n      required: true,\r\n    },\r\n    id: {\r\n      type: String,\r\n      required: true,\r\n    },\r\n  },\r\n\r\n  setup(props, { emit }) {\r\n    const password = ref(props.modelValue);\r\n    const { translationsLang } = useTranslations();\r\n\r\n    watch(password, (newVal) => {\r\n      emit(\"update:modelValue\", newVal);\r\n    });\r\n\r\n    return {\r\n      translationsLang,\r\n      password,\r\n    };\r\n  },\r\n};\r\n</script>\r\n"],"mappings":"AAkCA,SAASA,KAAK,EAAEC,GAAE,QAAS,KAAK;AAChC,OAAOC,eAAc,MAAO,+BAA+B;AAE3D,eAAe;EACbC,IAAI,EAAE,qBAAqB;EAC3BC,KAAK,EAAE;IACLC,UAAU,EAAE;MACVC,IAAI,EAAEC,MAAM;MACZC,OAAO,EAAE;IACX,CAAC;IACDC,CAAC,EAAE;MACDH,IAAI,EAAEI,MAAM;MACZC,QAAQ,EAAE;IACZ,CAAC;IACDC,EAAE,EAAE;MACFN,IAAI,EAAEC,MAAM;MACZI,QAAQ,EAAE;IACZ;EACF,CAAC;EAEDE,KAAKA,CAACT,KAAK,EAAE;IAAEU;EAAK,CAAC,EAAE;IACrB,MAAMC,QAAO,GAAId,GAAG,CAACG,KAAK,CAACC,UAAU,CAAC;IACtC,MAAM;MAAEW;IAAiB,IAAId,eAAe,CAAC,CAAC;IAE9CF,KAAK,CAACe,QAAQ,EAAGE,MAAM,IAAK;MAC1BH,IAAI,CAAC,mBAAmB,EAAEG,MAAM,CAAC;IACnC,CAAC,CAAC;IAEF,OAAO;MACLD,gBAAgB;MAChBD;IACF,CAAC;EACH;AACF,CAAC"},"metadata":{},"sourceType":"module","externalDependencies":[]}
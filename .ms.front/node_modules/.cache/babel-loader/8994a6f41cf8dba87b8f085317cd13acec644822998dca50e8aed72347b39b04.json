{"ast":null,"code":"import { ref, watch } from \"vue\";\nimport useTranslations from \"@/composables/useTranslations\";\nexport default {\n  name: \"NameField\",\n  props: {\n    modelValue: {\n      type: String,\n      default: \"\"\n    },\n    v: {\n      type: Object,\n      required: true\n    },\n    label: {\n      type: String,\n      default: \"Имя\"\n    },\n    id: {\n      type: String,\n      required: true\n    }\n  },\n  setup(props, {\n    emit\n  }) {\n    const name = ref(props.modelValue);\n    const {\n      translationsLang\n    } = useTranslations();\n    watch(name, newVal => {\n      emit(\"update:modelValue\", newVal);\n    });\n    const onInput = event => {\n      const sourceValue = event.target.value;\n      const newValue = sourceValue.replace(/[^a-zA-Zа-яА-ЯёЁ_]/g, \"\");\n      if (sourceValue !== newValue) {\n        name.value = newValue;\n      }\n    };\n    return {\n      name,\n      translationsLang,\n      onInput\n    };\n  }\n};","map":{"version":3,"names":["ref","watch","useTranslations","name","props","modelValue","type","String","default","v","Object","required","label","id","setup","emit","translationsLang","newVal","onInput","event","sourceValue","target","value","newValue","replace"],"sources":["G:\\develop\\commands_project\\git_hub\\command_project\\frontend-vue3\\src\\components\\FormElements\\NameField.vue"],"sourcesContent":["<template>\r\n  <div class=\"form__group\" :class=\"{ fill: name.length > 0 }\">\r\n    <input\r\n      type=\"text\"\r\n      class=\"form__input_stylus\"\r\n      :id=\"id\"\r\n      v-model=\"name\"\r\n      name=\"name\"\r\n      :class=\"{\r\n        invalid: (v.$dirty && !v.required) || (v.$dirty && !v.minLength),\r\n      }\"\r\n      @change=\"v.$touch()\"\r\n      @input=\"onInput\"\r\n    />\r\n\r\n    <label :for=\"id\" class=\"form__label_stylus\">{{ label }}</label>\r\n\r\n    <span class=\"form__error\" v-if=\"v.$dirty && !v.required\">{{\r\n      translationsLang.requiredField\r\n    }}</span>\r\n\r\n    <span class=\"form__error\" v-else-if=\"v.$dirty && !v.minLength\">\r\n      {{ translationsLang.minimumNumberOfCharacters }} {{ v.minLength }}\r\n    </span>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport { ref, watch } from \"vue\";\r\nimport useTranslations from \"@/composables/useTranslations\";\r\n\r\nexport default {\r\n  name: \"NameField\",\r\n  props: {\r\n    modelValue: {\r\n      type: String,\r\n      default: \"\",\r\n    },\r\n    v: {\r\n      type: Object,\r\n      required: true,\r\n    },\r\n    label: {\r\n      type: String,\r\n      default: \"Имя\",\r\n    },\r\n    id: {\r\n      type: String,\r\n      required: true,\r\n    },\r\n  },\r\n\r\n  setup(props, { emit }) {\r\n    const name = ref(props.modelValue);\r\n    const { translationsLang } = useTranslations();\r\n\r\n    watch(name, (newVal) => {\r\n      emit(\"update:modelValue\", newVal);\r\n    });\r\n\r\n    const onInput = (event) => {\r\n      const sourceValue = event.target.value;\r\n      const newValue = sourceValue.replace(/[^a-zA-Zа-яА-ЯёЁ_]/g, \"\");\r\n      if (sourceValue !== newValue) {\r\n        name.value = newValue;\r\n      }\r\n    };\r\n\r\n    return {\r\n      name,\r\n      translationsLang,\r\n      onInput,\r\n    };\r\n  },\r\n};\r\n</script>\r\n"],"mappings":"AA4BA,SAASA,GAAG,EAAEC,KAAI,QAAS,KAAK;AAChC,OAAOC,eAAc,MAAO,+BAA+B;AAE3D,eAAe;EACbC,IAAI,EAAE,WAAW;EACjBC,KAAK,EAAE;IACLC,UAAU,EAAE;MACVC,IAAI,EAAEC,MAAM;MACZC,OAAO,EAAE;IACX,CAAC;IACDC,CAAC,EAAE;MACDH,IAAI,EAAEI,MAAM;MACZC,QAAQ,EAAE;IACZ,CAAC;IACDC,KAAK,EAAE;MACLN,IAAI,EAAEC,MAAM;MACZC,OAAO,EAAE;IACX,CAAC;IACDK,EAAE,EAAE;MACFP,IAAI,EAAEC,MAAM;MACZI,QAAQ,EAAE;IACZ;EACF,CAAC;EAEDG,KAAKA,CAACV,KAAK,EAAE;IAAEW;EAAK,CAAC,EAAE;IACrB,MAAMZ,IAAG,GAAIH,GAAG,CAACI,KAAK,CAACC,UAAU,CAAC;IAClC,MAAM;MAAEW;IAAiB,IAAId,eAAe,CAAC,CAAC;IAE9CD,KAAK,CAACE,IAAI,EAAGc,MAAM,IAAK;MACtBF,IAAI,CAAC,mBAAmB,EAAEE,MAAM,CAAC;IACnC,CAAC,CAAC;IAEF,MAAMC,OAAM,GAAKC,KAAK,IAAK;MACzB,MAAMC,WAAU,GAAID
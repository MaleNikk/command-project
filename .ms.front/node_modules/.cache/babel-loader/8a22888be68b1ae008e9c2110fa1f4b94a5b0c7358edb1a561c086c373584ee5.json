{"ast":null,"code":"import { ref, computed, onMounted } from \"vue\";\nimport { useStore } from \"vuex\";\nimport RecommendFriend from \"@/components/RecommendFriend.vue\";\nimport NewsBlock from \"@/components/News/Block\";\nimport NewsAdd from \"@/components/News/Add\";\nimport Spinner from \"@/components/SpinnerComponents.vue\";\nimport ErrorBlock from \"@/components/ErrorBlock.vue\";\nimport AutoPaginator from \"@/components/AutoPaginator.vue\";\nexport default {\n  name: \"UserNews\",\n  components: {\n    NewsBlock,\n    NewsAdd,\n    Spinner,\n    ErrorBlock,\n    AutoPaginator,\n    RecommendFriend\n  },\n  setup() {\n    const {\n      getters,\n      state,\n      dispatch,\n      commit\n    } = useStore();\n    const frinedsList = ref(null);\n    const getInfo = computed(() => getters[\"profile/info/getInfo\"]);\n    const loading = computed(() => state.global.status.loading);\n    const error = computed(() => state.global.status.error);\n    const errorMessage = computed(() => state.global.status.errorMessage);\n    const feeds = computed(() => state.profile.feeds.feeds);\n    const feedsPagination = computed(() => state.profile.feeds.feedsPagination);\n    const filteredWall = computed(() => {\n      const wall = feeds.value;\n      const posted = wall.filter(item => item.type === \"POSTED\");\n      const queued = wall.filter(item => item.type === \"QUEUED\");\n      return {\n        posted,\n        queued\n      };\n    });\n    onMounted(async () => {\n      commit(\"profile/feeds/clearFeeds\");\n    });\n    const apiFeeds = () => {\n      dispatch(\"profile/feeds/apiFeeds\");\n    };\n    // const setFeeds = () => {\n    //   commit(\"profile/feeds/setFeeds\");\n    // };\n\n    return {\n      frinedsList,\n      getInfo,\n      loading,\n      error,\n      errorMessage,\n      feeds,\n      feedsPagination,\n      filteredWall,\n      apiFeeds\n    };\n  }\n};","map":{"version":3,"names":["ref","computed","onMounted","useStore","RecommendFriend","NewsBlock","NewsAdd","Spinner","ErrorBlock","AutoPaginator","name","components","setup","getters","state","dispatch","commit","frinedsList","getInfo","loading","global","status","error","errorMessage","feeds","profile","feedsPagination","filteredWall","wall","value","posted","filter","item","type","queued","apiFeeds"],"sources":["G:\\develop\\commands_project\\repository\\frontend-vue3\\src\\pages\\User\\News.vue"],"sourcesContent":["<template>\r\n  <div class=\"news inner-page\">\r\n    <div class=\"inner-page__main\">\r\n      <div class=\"inner-page__main__container\">\r\n        <div class=\"news__add\">\r\n          <news-add user=\"user\" />\r\n        </div>\r\n\r\n        <template v-if=\"feeds\">\r\n          <div class=\"news__list\" v-if=\"getInfo\">\r\n            <news-block\r\n              v-for=\"feed in filteredWall.posted\"\r\n              :key=\"feed.id\"\r\n              :info=\"feed\"\r\n              :queued=\"false\"\r\n              :edit=\"getInfo.id === feed.author.id\"\r\n              :deleted=\"getInfo.id === feed.author.id\"\r\n            />\r\n          </div>\r\n        </template>\r\n\r\n        <div class=\"spinner-wrapper\" v-if=\"loading\">\r\n          <spinner />\r\n        </div>\r\n\r\n        <error-block v-if=\"!loading && error\" :message=\"errorMessage\" />\r\n      </div>\r\n\r\n      <recommend-friend />\r\n\r\n      <auto-paginator\r\n        :page=\"feedsPagination.page || 0\"\r\n        :loading=\"loading\"\r\n        :totalPage=\"feedsPagination.total\"\r\n        :action=\"apiFeeds\"\r\n      />\r\n    </div>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport { ref, computed, onMounted } from \"vue\";\r\nimport { useStore } from \"vuex\";\r\nimport RecommendFriend from \"@/components/RecommendFriend.vue\";\r\nimport NewsBlock from \"@/components/News/Block\";\r\nimport NewsAdd from \"@/components/News/Add\";\r\nimport Spinner from \"@/components/SpinnerComponents.vue\";\r\nimport ErrorBlock from \"@/components/ErrorBlock.vue\";\r\nimport AutoPaginator from \"@/components/AutoPaginator.vue\";\r\n\r\nexport default {\r\n  name: \"UserNews\",\r\n  components: {\r\n    NewsBlock,\r\n    NewsAdd,\r\n    Spinner,\r\n    ErrorBlock,\r\n    AutoPaginator,\r\n    RecommendFriend,\r\n  },\r\n\r\n  setup() {\r\n    const { getters, state, dispatch, commit } = useStore();\r\n    const frinedsList = ref(null);\r\n\r\n    const getInfo = computed(() => getters[\"profile/info/getInfo\"]);\r\n\r\n    const loading = computed(() => state.global.status.loading);\r\n    const error = computed(() => state.global.status.error);\r\n    const errorMessage = computed(() => state.global.status.errorMessage);\r\n    const feeds = computed(() => state.profile.feeds.feeds);\r\n    const feedsPagination = computed(() => state.profile.feeds.feedsPagination);\r\n\r\n    const filteredWall = computed(() => {\r\n      const wall = feeds.value;\r\n      const posted = wall.filter((item) => item.type === \"POSTED\");\r\n      const queued = wall.filter((item) => item.type === \"QUEUED\");\r\n      return { posted, queued };\r\n    });\r\n\r\n    onMounted(async () => {\r\n      commit(\"profile/feeds/clearFeeds\");\r\n    });\r\n\r\n    const apiFeeds = () => {\r\n      dispatch(\"profile/feeds/apiFeeds\");\r\n    };\r\n    // const setFeeds = () => {\r\n    //   commit(\"profile/feeds/setFeeds\");\r\n    // };\r\n\r\n    return {\r\n      frinedsList,\r\n      getInfo,\r\n      loading,\r\n      error,\r\n      errorMessage,\r\n      feeds,\r\n      feedsPagination,\r\n      filteredWall,\r\n      apiFeeds,\r\n    };\r\n  },\r\n};\r\n</script>\r\n\r\n<style lang=\"stylus\">\r\n@import '@/assets/stylus/base/vars.styl';\r\n\r\n.news-block__changed-time\r\n  top 15px\r\n\r\n.news-block .edit\r\n  top 50px\r\n\r\n.edit--small\r\n  top 25px !important\r\n\r\n.news__add\r\n  border-radius border-small\r\n  margin-bottom 30px\r\n\r\n.news-add\r\n  border-radius border-small\r\n\r\n.news__list\r\n  display flex\r\n  flex-direction column\r\n  gap 20px\r\n  margin-bottom 30px\r\n\r\n@media (min-width: 320px) and (max-width: 768px)\r\n  .inner-page\r\n    &__main__container\r\n      margin-right 0 !important\r\n</style>\r\n\r\n<style lang=\"stylus\" scoped>\r\n.spinner-wrapper\r\n  width 100px\r\n  height 100px\r\n  margin 0 auto\r\n  padding 50px\r\n</style>\r\n"],"mappings":"AAyCA,SAASA,GAAG,EAAEC,QAAQ,EAAEC,SAAQ,QAAS,KAAK;AAC9C,SAASC,QAAO,QAAS,MAAM;AAC/B,OAAOC,eAAc,MAAO,kCAAkC;AAC9D,OAAOC,SAAQ,MAAO,yBAAyB;AAC/C,OAAOC,OAAM,MAAO,uBAAuB;AAC3C,OAAOC,OAAM,MAAO,oCAAoC;AACxD,OAAOC,UAAS,MAAO,6BAA6B;AACpD,OAAOC,aAAY,MAAO,gCAAgC;AAE1D,eAAe;EACbC,IAAI,EAAE,UAAU;EAChBC,UAAU,EAAE;IACVN,SAAS;IACTC,OAAO;IACPC,OAAO;IACPC,UAAU;IACVC,aAAa;IACbL;EACF,CAAC;EAEDQ,KAAKA,CAAA,EAAG;IACN,MAAM;MAAEC,OAAO;MAAEC,KAAK;MAAEC,QAAQ;MAAEC;IAAO,IAAIb,QAAQ,CAAC,CAAC;IACvD,MAAMc,WAAU,GAAIjB,GAAG,CAAC,IAAI,CAAC;IAE7B,MAAMkB,OAAM,GAAIjB,QAAQ,CAAC,MAAMY,OAAO,CAAC,sBAAsB,CAAC,CAAC;IAE/D,MAAMM,OAAM,GAAIlB,QAAQ,CAAC,MAAMa,KAAK,CAACM,MAAM,CAACC,MAAM,CAACF,OAAO,CAAC;IAC3D,MAAMG,KAAI,GAAIrB,QAAQ,CAAC,MAAMa,KAAK,CAACM,MAAM,CAACC,MAAM,CAACC,KAAK,CAAC;IACvD,MAAMC,YAAW,GAAItB,QAAQ,CAAC,MAAMa,KAAK,CAACM,MAAM,CAACC,MAAM,CAACE,YAAY,CAAC;IACrE,MAAMC,KAAI,GAAIvB,QAAQ,CAAC,MAAMa,KAAK,CAACW,OAAO,CAACD,KAAK,CAACA,KAAK,CAAC;IACvD,MAAME,eAAc,GAAIzB,QAAQ,CAAC,MAAMa,KAAK,CAACW,OAAO,CAACD,KAAK,CAACE,eAAe,CAAC;IAE3E,MAAMC,YAAW,GAAI1B,QAAQ,CAAC,MAAM;MAClC,MAAM2B,IAAG,GAAIJ,KAAK,CAACK,KAAK;MACxB,MAAMC,MAAK,GAAIF,IAAI,CAACG,MAAM,CAAEC,IAAI,IAAKA,IAAI,CAACC,IAAG,KAAM,QAAQ,CAAC;MAC5D,MAAMC,MAAK,GAAIN,IAAI,CAACG,MAAM,CAAEC,IAAI,IAAKA,IAAI,CAACC,IAAG,KAAM,QAAQ,CAAC;MAC5D,OAAO;QAAEH,MAAM;QAAEI;MAAO,CAAC;IAC3B,CAAC,CAAC;IAEFhC,SAAS,CAAC,YAAY;MACpBc,MAAM,CAAC,0BAA0B,CAAC;IACpC,CAAC,CAAC;IAEF,MAAMmB,QAAO,GAAIA,CAAA,KAAM;MACrBpB,QAAQ,CAAC,wBAAwB,CAAC;IACpC,CAAC;IACD;IACA;IACA;;IAEA,OAAO;MACLE,WAAW;MACXC,OAAO;MACPC,OAAO;MACPG,KAAK;MACLC,YAAY;MACZC,KAAK;MACLE,eAAe;MACfC,YAAY;MACZQ;IACF,CAAC;EACH;AACF,CAAC"},"metadata":{},"sourceType":"module","
{"ast":null,"code":"import { ref } from \"vue\";\nimport useTranslations from \"@/composables/useTranslations\";\nexport default {\n  name: \"EmailField\",\n  props: {\n    modelValue: {\n      type: String,\n      default: \"\"\n    },\n    v: {\n      type: Object,\n      required: true\n    },\n    id: {\n      type: String,\n      required: true\n    },\n    placeholder: {\n      type: String,\n      default: \"E-mail\"\n    }\n  },\n  setup(props, {\n    emit\n  }) {\n    const email = ref(props.modelValue);\n    const {\n      translationsLang\n    } = useTranslations();\n    const updateValue = value => {\n      email.value = value;\n      emit(\"update:modelValue\", value);\n    };\n    return {\n      email,\n      translationsLang,\n      updateValue\n    };\n  }\n};","map":{"version":3,"names":["ref","useTranslations","name","props","modelValue","type","String","default","v","Object","required","id","placeholder","setup","emit","email","translationsLang","updateValue","value"],"sources":["B:\\develop\\commands_project\\repository\\frontend-vue3\\src\\components\\FormElements\\EmailField.vue"],"sourcesContent":["<template>\r\n  <div class=\"form__group\" :class=\"{ fill: email.length > 0 }\">\r\n    <input\r\n      class=\"form__input_stylus\"\r\n      :id=\"id\"\r\n      :value=\"modelValue\"\r\n      @input=\"updateValue($event.target.value)\"\r\n      name=\"email\"\r\n      :class=\"{\r\n        invalid:\r\n          (v.$dirty && !v.required) ||\r\n          (v.$dirty && !v.email) ||\r\n          /\\s/.test(email),\r\n      }\"\r\n      @change=\"v.$touch()\"\r\n      autocomplete=\"email\"\r\n    />\r\n\r\n    <label class=\"form__label_stylus\" :for=\"id\">{{ placeholder }}</label>\r\n\r\n    <span class=\"form__error\" v-if=\"v.$dirty && !v.required\">\r\n      {{ translationsLang.enterEmail }}\r\n    </span>\r\n\r\n    <span class=\"form__error\" v-else-if=\"v.$dirty && !v.email\">\r\n      {{ translationsLang.correctEmail }}\r\n    </span>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport { ref } from \"vue\";\r\nimport useTranslations from \"@/composables/useTranslations\";\r\n\r\nexport default {\r\n  name: \"EmailField\",\r\n  props: {\r\n    modelValue: {\r\n      type: String,\r\n      default: \"\",\r\n    },\r\n    v: {\r\n      type: Object,\r\n      required: true,\r\n    },\r\n    id: {\r\n      type: String,\r\n      required: true,\r\n    },\r\n    placeholder: {\r\n      type: String,\r\n      default: \"E-mail\",\r\n    },\r\n  },\r\n\r\n  setup(props, { emit }) {\r\n    const email = ref(props.modelValue);\r\n    const { translationsLang } = useTranslations();\r\n\r\n    const updateValue = (value) => {\r\n      email.value = value;\r\n      emit(\"update:modelValue\", value);\r\n    };\r\n\r\n    return {\r\n      email,\r\n      translationsLang,\r\n      updateValue,\r\n    };\r\n  },\r\n};\r\n</script>\r\n"],"mappings":"AA+BA,SAASA,GAAE,QAAS,KAAK;AACzB,OAAOC,eAAc,MAAO,+BAA+B;AAE3D,eAAe;EACbC,IAAI,EAAE,YAAY;EAClBC,KAAK,EAAE;IACLC,UAAU,EAAE;MACVC,IAAI,EAAEC,MAAM;MACZC,OAAO,EAAE;IACX,CAAC;IACDC,CAAC,EAAE;MACDH,IAAI,EAAEI,MAAM;MACZC,QAAQ,EAAE;IACZ,CAAC;IACDC,EAAE,EAAE;MACFN,IAAI,EAAEC,MAAM;MACZI,QAAQ,EAAE;IACZ,CAAC;IACDE,WAAW,EAAE;MACXP,IAAI,EAAEC,MAAM;MACZC,OAAO,EAAE;IACX;EACF,CAAC;EAEDM,KAAKA,CAACV,KAAK,EAAE;IAAEW;EAAK,CAAC,EAAE;IACrB,MAAMC,KAAI,GAAIf,GAAG,CAACG,KAAK,CAACC,UAAU,CAAC;IACnC,MAAM;MAAEY;IAAiB,IAAIf,eAAe,CAAC,CAAC;IAE9C,MAAMgB,WAAU,GAAKC,KAAK,IAAK;MAC7BH,KAAK,CAACG,KAAI,GAAIA,KAAK;MACnBJ,IAAI,CAAC,mBAAmB,EAAEI,KAAK,CAAC;IAClC,CAAC;IAED,OAAO;MACLH,KAAK;MACLC,gBAAgB;MAChBC;IACF,CAAC;EACH;AACF,CAAC"},"metadata":{},"sourceType":"module","externalDependencies":[]}
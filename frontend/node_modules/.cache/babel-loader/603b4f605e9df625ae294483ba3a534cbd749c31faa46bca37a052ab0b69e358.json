{"ast":null,"code":"import { computed } from \"vue\";\nimport { useStore } from \"vuex\";\nimport dayjs from \"dayjs\";\nimport { getRouteByNotification } from \"@/utils/notifications.utils\";\nexport default {\n  name: \"PushBlock\",\n  props: {\n    info: Object\n  },\n  setup() {\n    const store = useStore();\n    const getNotificationsTextType = computed(() => store.getters[\"profile/notifications/getNotificationsTextType\"]);\n    const formatSentTime = time => {\n      return dayjs(time).fromNow();\n    };\n    return {\n      getRouteByNotification,\n      getNotificationsTextType,\n      formatSentTime\n    };\n  }\n};","map":{"version":3,"names":["computed","useStore","dayjs","getRouteByNotification","name","props","info","Object","setup","store","getNotificationsTextType","getters","formatSentTime","time","fromNow"],"sources":["B:\\develop\\commands_project\\repository\\frontend-vue3\\src\\components\\Push\\Block.vue"],"sourcesContent":["<template>\r\n  <div class=\"push-block\">\r\n    <div class=\"push__img\" v-if=\"info.author.photo\">\r\n      <img :src=\"info.author.photo\" :alt=\"info.author.firstName[0]\" />\r\n    </div>\r\n\r\n    <div class=\"push__img\" v-else>\r\n      <div>\r\n        {{ info.author.firstName[0] + \" \" + info.author.lastName[0] }}\r\n      </div>\r\n    </div>\r\n\r\n    <p class=\"push__content\">\r\n      <router-link\r\n        class=\"push__content-name\"\r\n        :to=\"getRouteByNotification(info)\"\r\n      >\r\n        <span class=\"push__content-preview\">{{ info.content }}</span>\r\n        {{ getNotificationsTextType(info.notificationType) }}\r\n        {{ info.author.firstName + ' ' + info.author.lastName }}\r\n      </router-link>\r\n    </p>\r\n\r\n    <span class=\"push__time\">{{ formatSentTime(info.sentTime) }}</span>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport { computed } from \"vue\";\r\nimport { useStore } from \"vuex\";\r\nimport dayjs from \"dayjs\";\r\nimport { getRouteByNotification } from 
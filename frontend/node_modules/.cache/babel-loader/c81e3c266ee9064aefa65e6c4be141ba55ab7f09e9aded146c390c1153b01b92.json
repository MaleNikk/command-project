{"ast":null,"code":"import { ref, computed } from 'vue';\nimport { useStore } from 'vuex';\nimport { useRoute } from 'vue-router';\nimport useTranslations from '@/composables/useTranslations';\nexport default {\n  name: 'FormLayoutInfo',\n  setup() {\n    const store = useStore();\n    const route = useRoute();\n    const language = ref('');\n    const isOpenLanguageBlock = ref(false);\n    const {\n      translationsInfo\n    } = useTranslations();\n    const info = computed(() => store.getters['auth/info/getInfoById'](route.path.split('/')[1]));\n    const buttonLink = computed(() => {\n      if (info.value.btn && info.value.btn.href) {\n        return info.value.btn.href;\n      }\n      return {\n        name: info.value.btn.link\n      };\n    });\n    return {\n      info,\n      buttonLink,\n      language,\n      isOpenLanguageBlock,\n      translationsInfo\n    };\n  }\n};","map":{"version":3,"names":["ref","computed","useStore","useRoute","useTranslations","name","setup","store","route","language","isOpenLanguageBlock","translationsInfo","info","getters","path","split","buttonLink","value","btn","href","link"],"sources":["G:\\develop\\commands_project\\git_hub\\command_project\\frontend-vue3\\src\\components\\FormLayout\\FormLayoutInfo.vue"],"sourcesContent":["<template>\r\n  <div class=\"form-layout__main\">\r\n    <div class=\"form-layout__logo\">\r\n      <p>CONVERSATION SERVICE</p>\r\n    </div>\r\n    <h1 class=\"form-layout__title\">{{ translationsInfo.title }}</h1>\r\n    <p class=\"form-layout__text\">{{ translationsInfo.text }}</p>\r\n    <p class=\"form-layout__descr\" v-if=\"info.descr\">{{ translationsInfo.descr }}</p>\r\n\r\n    <router-link v-if=\"info.btn\" :to=\"buttonLink\">\r\n      <button class=\"form-layout__btn\">{{ translationsInfo.btn.text }}</button>\r\n    </router-link>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport { ref, computed } from 'vue';\r\nimport { useStore } from 'vuex';\r\nimport { useRoute } from 'vue-router';\r\nimport useTranslations from '@/composables/useTranslations';\r\n\r\nexport default {\r\n  name: 'FormLayoutInfo',\r\n  setup() {\r\n    const store = useStore();\r\n    const route = useRoute();\r\n    const language = ref('');\r\n    const isOpenLanguageBlock = ref(false);\r\n    const { translationsInfo } = useTranslations();\r\n\r\n    const info = computed(() => store.getters['auth/info/getInfoById'](route.path.split('/')[1]));\r\n\r\n    const buttonLink = computed(() => {\r\n      if (info.value.btn && info.value.btn.href) {\r\n        return info.value.btn.href;\r\n      }\r\n      return { name: info.value.btn.link };\r\n    });\r\n\r\n    return {\r\n      info,\r\n      buttonLink,\r\n      language,\r\n      isOpenLanguageBlock,\r\n      translationsInfo,\r\n    };\r\n  },\r\n};\r\n</script>\r\n\r\n<style lang=\"stylus\">\r\n@import '@/assets/stylus/base/vars.styl';\r\n\r\n.form-layout__main\r\n  margin auto 0\r\n  margin-bottom 30px\r\n\r\n.form-layout__logo\r\n  position absolute\r\n  top 30px\r\n  left 30px\r\n  z-index 1000\r\n  display inline-flex\r\n  border-radius border-small\r\n  user-select none\r\n  pointer-events none\r\n  gap 10px\r\n  max-width unset\r\n  p\r\n    color ui-cl-color-white-theme\r\n    font-size 25px\r\n    font-weight font-weight-light\r\n    text-transform uppercase\r\n\r\n.form-layout__title\r\n  color ui-cl-color-white-theme\r\n  font-style normal\r\n  font-weight font-weight-light\r\n  font-size 40px\r\n  line-height 53px\r\n  letter-spacing -0.01em\r\n  margin-bottom 20px\r\n\r\n.form-layout__text\r\n  font-size font-size-updefault\r\n  line-height 30px\r\n  letter-spacing 0.01em\r\n  color ui-cl-color-jumbo\r\n  margin-bottom 20px\r\n\r\n.form-layout__descr\r\n  font-size font-size-downdefault\r\n  letter-spacing 0.01em\r\n  color ui-cl-color-scarpa-flow\r\n  margin-bottom 15px\r\n  margin-top 30px\r\n</style>\r\n"],"mappings":"AAgBA,SAASA,GAAG,EAAEC,QAAO,QAAS,KAAK;AACnC,SAASC,QAAO,QAAS,MAAM;AAC/B,SAASC,QAAO,QAAS,YAAY
<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
    http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="createTableNotification" author="notifications_db">
        <createTable tableName="notifications.notification">
            <column name="id" type="UUID NOT NULL">
                <constraints primaryKey="true"/>
            </column>
            <column name="account_id" type="UUID NOT NULL"/>
            <column name="content" type="TEXT NOT NULL"/>
            <column name="notification_type" type="VARCHAR(50) NOT NULL"/>
            <column name="sent_time" type="DATE NOT NULL"/>
            <column name="receiver_id" type="UUID NOT NULL"/>
            <column name="service_type" type="VARCHAR(50) NOT NULL"/>
            <column name="event_id" type="UUID NOT NULL"/>
            <column name="is_reed" type="BOOLEAN DEFAULT FALSE"/>
        </createTable>
    </changeSet>

    <changeSet id="createTableSettings" author="notifications_db">
        <createTable tableName="notifications.settings">
            <column name="id" type="UUID NOT NULL">
                <constraints primaryKey="true"/>
            </column>
            <column name="enable_notifications" type="BOOLEAN DEFAULT TRUE"/>
            <column name="enable_post" type="BOOLEAN DEFAULT TRUE"/>
            <column name="enable_post_comment" type="BOOLEAN DEFAULT TRUE"/>
            <column name="enable_comment_comment" type="BOOLEAN DEFAULT TRUE"/>
            <column name="enable_friend_request" type="BOOLEAN DEFAULT TRUE"/>
            <column name="enable_friend_birthday" type="BOOLEAN DEFAULT TRUE"/>
            <column name="enable_message" type="BOOLEAN DEFAULT TRUE"/>
        </createTable>
    </changeSet>
</databaseChangeLog>